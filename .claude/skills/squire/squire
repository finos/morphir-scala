#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if command -v jsonschema >/dev/null 2>&1; then
  export SQUIRE_JSONSCHEMA_BIN
  SQUIRE_JSONSCHEMA_BIN="$(command -v jsonschema)"
fi
cd "$DIR"
exec "$DIR/mill" --no-server --ticker false squire.scala "$@"
