/** `tests.jvm.test`'s source override: in addition to the shared `test/src` (+ `test/src-3`) that Mill's own
  * TestModule default already finds, also pick up `test/jvm-native/src` — files shared only between the jvm and
  * native targets (native itself is disabled repo-wide, so in practice this is jvm-only test code kept apart from
  * the plain shared `test/src`).
  */
trait MorphirTestsJVMTestSources extends JavaModule {
  override def sources: T[Seq[PathRef]] = Task.Sources(
    moduleDir / "src",
    moduleDir / "src-3",
    moduleDir / "jvm-native" / "src"
  )
}

/**
 * Scoverage wiring for `contrib.knowledge.jvm`.
 *
 * `scoverageVersion` lives here rather than as a `package.mill.yaml` key: a YAML override only binds against tasks
 * Mill can see on the declared bases, and a plain `scoverageVersion: <v>` entry fails resolution with `key
 * "scoverageVersion" does not override any task on Module`. That error only surfaces on broad selectors such as
 * `morphir.__.jvm.__` or `morphir.__.sources` — which is what CI and `mise run lint` use — while narrower ones
 * resolve fine, so it is easy to miss locally.
 */
trait MorphirScoverage extends mill.contrib.scoverage.ScoverageModule {
  def scoverageVersion: T[String] = Task { Vers.scoverage }

  /** Mill's scoverage inner module copies `mvnDeps` but not `depManagement`, so versionless suite coords would
    * resolve as an empty version. Forward the enclosing module's pins.
    */
  override lazy val scoverage: ScoverageData = new ScoverageData {
    override def depManagement = Task { MorphirScoverage.this.depManagement() }
  }
}

/** `tests.js.test`'s source override: shared `test/src` (+ `test/src-3`) plus `test/js/src` — js-only test code. */
trait MorphirTestsJSTestSources extends JavaModule {
  override def sources: T[Seq[PathRef]] = Task.Sources(
    moduleDir / "src",
    moduleDir / "src-3",
    moduleDir / "js" / "src"
  )
}

/**
 * Injects the linked `langkit.elm.compiler.api.wasm` output directory into `langkit.itest`'s forked JVMs.
 *
 * `ChicoryCompilerWasmCompatibilityTest` reads `main.wasm` straight off disk to assert what the Scala.js Wasm linker
 * emits, so the suite needs the artifact path — and taking a task dependency here is also what makes Mill link the
 * Wasm module before the tests run. Lives in the metabuild because a per-directory `package.mill.yaml` can't express
 * a Task, and a `package.mill` in `morphir/langkit/itest/` can't statically reach another directory module's nested
 * `wasm` object under Mill 1.2.0-RC1.
 */
trait MorphirLangkitItestWasmArtifacts extends JavaModule {
  override def forkArgs: T[Seq[String]] = Task {
    val wasmDir = build.morphir.langkit.elm.compiler.api.wasm.fullLinkJS().dest.path
    super.forkArgs() ++ Seq(s"-Dmorphir.langkit.elm.compiler.api.wasm.dir=$wasmDir")
  }
}

/**
 * Real Elm packages, fetched at build time for the langkit's conformance corpus.
 *
 * The sources are third-party, so they stay out of the repository and arrive as build inputs: `ElmPackages` clones
 * each package at a pinned tag into this task's directory, and the path reaches the suite as a system property. The
 * task is cached on the pinned revisions, so the download happens once per revision bump rather than once per test
 * run.
 *
 * Fetching needs the network, so `mill --offline` skips it: the task writes a marker instead of cloning, says so in
 * the log, and `RealWorldCorpusTest` reports itself skipped rather than passing on an empty corpus. That is the only
 * way to run without the packages — a missing network without `--offline` fails the task, because a corpus that
 * quietly parses nothing is worse than a build that stops.
 */
trait MorphirLangkitItestElmPackages extends JavaModule {

  /** Written instead of the packages when Mill is run with `--offline`. */
  def elmCorpusOfflineMarker: String = "OFFLINE-SKIPPED"

  def elmCorpusPackages: T[PathRef] = Task {
    if (Task.offline) {
      Task.log.info(
        s"--offline: skipping the real-world Elm corpus. " +
          s"${millbuild.ElmPackages.corpus.size} package(s) not fetched, and RealWorldCorpusTest will report itself " +
          s"skipped. Drop --offline to fetch and run it."
      )
      os.write(Task.dest / elmCorpusOfflineMarker, millbuild.ElmPackages.corpus.map(_.repository).mkString("\n"))
    } else millbuild.ElmPackages.fetchAll(Task.dest)
    PathRef(Task.dest)
  }

  override def forkArgs: T[Seq[String]] = Task {
    super.forkArgs() ++ Seq(s"-Dmorphir.langkit.elm.corpus.packages=${elmCorpusPackages().path}")
  }
}

object toolchains extends Module {
  object node extends NodeToolchainModule
  object morphirElm extends RepositoryMorphirElmToolModule {
    def nodeToolchain = toolchains.node
  }
}

/** Repository tool-module reference that declarative Morphir Elm projects cannot express in Mill RC1 YAML. */
trait RepositoryMorphirElmToolReference extends Module {
  def morphirElmTool = toolchains.morphirElm
}

/** Exact local IR inputs shared by the three unit-test example consumers.
  *
  * Mill 1.2.0-RC1 cannot override the non-task `morphirModuleDeps` member from YAML, so this deliberately narrow
  * reference trait carries only those two module references. Project declarations and identity stay colocated in
  * each project's `package.mill.yaml`.
  */
trait ExampleProjectTestMorphirDependencies extends MorphirModule {
  override def morphirModuleDeps = Seq(
    build.`morphir-elm`.sdks.`morphir-unit-test`,
    build.examples.`morphir-elm-projects`.`unit-test-framework`.`example-project`
  )
}

// The following section contains aliases used to simplify build tasks

object MyAliases extends Aliases {
  def fmt           = alias("mill.scalalib.scalafmt.ScalafmtModule/reformatAll __.sources")
  def checkfmt      = alias("mill.scalalib.scalafmt.ScalafmtModule/checkFormatAll __.sources")
  def deps          = alias("mill.scalalib.Dependency/showUpdates")
  def testall       = alias("__.test")
  def testJVM       = alias("morphir.__.jvm.__.test")
  def testJVMPlatform = alias(
    "morphir.jvm.__.compile",
    "morphir.{buildkit.core,contrib.knowledge,extensibility,intelligence.sdk,interop.borer,interop.zio.json,kit.kyo,langkit.core,langkit.elm.compiler.api,langkit.elm.core,langkit.trees,lib.interop,model,model.lowering,naming,prelude,testing.generators,testing.zio,tests,tools}.jvm.__.compile",
    "morphir.jvm.publishArtifacts",
    "morphir.{buildkit.core,contrib.knowledge,extensibility,interop.borer,interop.zio.json,lib.interop,model,model.lowering,naming,prelude,tests,tools}.jvm.publishArtifacts",
    "morphir.{buildkit.core,contrib.knowledge,intelligence.sdk,interop.borer,interop.zio.json,kit.kyo,langkit.core,langkit.elm.compiler.api,langkit.elm.core,langkit.trees,model,model.lowering,prelude,tests}.jvm.test",
    "morphir.langkit.itest.testCached"
  )
  def testJVMCached = alias("morphir.__.jvm.__.testCached")
  def compileall    = alias("__.compile")
  def comptestall   = alias("__.compile", "__.test")
}
