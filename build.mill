/**
 * The version of Scala natively supported by the toolchain. Morphir itself may provide backends that generate code for
 * other Scala versions.
 */
val morphirScalaVersion: String = ScalaVers.scala3

val docsScalaVersion: String = ScalaVers.scala3

// Get workspace dir from the build context
val workspaceDir = mill.api.BuildCtx.workspaceRoot

def showBuildSettings() = Task.Command {
  println(s"morphirScalaVersion: ${morphirScalaVersion}")
  println(s"docsScalaVersion: ${docsScalaVersion}")
  println(s"scalaJSVersion: ${ScalaVers.scalaJSVersion}")
  println(s"scalaNativeVersion: ${ScalaVers.scalaNativeVersion}")
  ()
}

object scoverage extends ScoverageReport {
  // While the plugin doesn't seem to support multiple scala versions, that doesn't seem to impact the coverage
  // For overall coverage report, just specifying Scala 3
  def scalaVersion     = ScalaVers.scala3x
  def scoverageVersion = Vers.scoverage
}

trait MorphirPublishModule extends PublishModule with JavaModule with Mima with SonatypeCentralPublishModule {
  import mill.scalalib.publish.*

  def publishVersion             = VcsVersion.vcsState().format()
  def packageDescription: String = s"The $artifactName package"
  def pomSettings                = PomSettings(
    description = packageDescription,
    organization = "org.finos.morphir",
    url = "https://github.com/finos/morphir-scala",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("finos", "morphir-scala"),
    developers = Seq(
      Developer("DamianReeves", "Damian Reeves", "https://github.com/damianreeves")
    )
  )
}

trait MorphirIntelligencePublishModule extends MorphirPublishModule {
  import mill.scalalib.publish.*
  override def pomSettings = super.pomSettings().copy(organization = "org.finos.morphir.intelligence")
}

trait MorphirCommonModule extends ScalaModule with CommonScalaModule {
  def scalaVersion: T[String]      = Task { morphirScalaVersion }
  def semanticDbVersion: T[String] = Task { Vers.semanticDb }

  def compilerPluginDependencies(selectedScalaVersion: String) =
    Seq(Deps.org.`scala-lang`.`scala3-compiler`(selectedScalaVersion))
}

trait DeduplicatedSources extends ScalaModule {
  override def sources: T[Seq[PathRef]] = Task {
    super.sources().distinctBy(_.path)
  }
}

trait MorphirCommonCrossModule extends CrossPlatformScalaModule with ScalafmtModule with DeduplicatedSources {
  def scalaVersion                                             = Task { morphirScalaVersion }
  def semanticDbVersion: T[String]                             = Task { Vers.semanticDb }
  def compilerPluginDependencies(selectedScalaVersion: String) =
    Seq(Deps.org.`scala-lang`.`scala3-compiler`(selectedScalaVersion))
}

trait MorphirJVMModule extends MorphirCommonCrossModule {
  def platform = Platform.JVM
}

trait MorphirJSModule extends MorphirCommonCrossModule with ScalaJSModule {
  import mill.scalajslib.api.*
  def platform       = Platform.JS
  def scalaJSVersion = Task { ScalaVers.scalaJSVersion }
}

trait MorphirNativeModule extends MorphirCommonCrossModule with ScalaNativeModule {
  def platform           = Platform.Native
  def scalaNativeVersion = Task { ScalaVers.scalaNativeVersion }
}

/** Shared BuildInfo wiring: version + scalaVersion members. Requires [[PublishModule]] + [[ScalaModule]].
  *
  * Extracted to the metabuild because it's mixed in from per-directory `package.mill`/`package.mill.yaml` files —
  * their own `moduleDir`-relative source computations can't statically see other directories' modules, but a named
  * trait like this one resolves fine via `extends:` regardless of which file references it.
  */
trait MorphirVersionBuildInfo extends BuildInfo with PublishModule with ScalaModule {
  def buildInfoMembers = Seq(
    BuildInfo.Value("version", publishVersion()),
    BuildInfo.Value("scalaVersion", scalaVersion())
  )
}

/** [[MorphirVersionBuildInfo]] variant that also reports the cross-platform target (jvm/js/native). */
trait MorphirPlatformBuildInfo extends MorphirVersionBuildInfo {
  def platform: Platform
  override def buildInfoMembers = Task { super.buildInfoMembers() ++ Seq(
    BuildInfo.Value("platform", platform.toString)
  ) }
}

/** [[MorphirPlatformBuildInfo]] for `extensibility` — `buildInfoPackageName` hardcoded here rather than left for
  * per-leaf YAML override, since overriding plain (non-Task) BuildInfo members via YAML `extends:` chains didn't
  * take effect in practice (Mill 1.2.0-RC1) — worth re-checking against a later Mill release.
  */
trait MorphirExtensibilityBuildInfo extends MorphirPlatformBuildInfo {
  def buildInfoPackageName = "org.finos.morphir.extensibility"
}

/** [[MorphirVersionBuildInfo]] for `morphir.main` (the CLI) — see [[MorphirExtensibilityBuildInfo]] for why this is
  * hardcoded rather than YAML-overridden.
  */
trait MorphirCliBuildInfo extends MorphirVersionBuildInfo {
  def buildInfoPackageName = "org.finos.morphir.cli"
}

/** BuildInfo wiring for `morphir.intelligence` — its own member set (adds JVM build info, no `platform` member
  * since this module isn't cross-platform) and package name, both hardcoded per [[MorphirExtensibilityBuildInfo]].
  */
trait MorphirIntelligenceBuildInfo extends BuildInfo with PublishModule with ScalaModule {
  def buildInfoPackageName = "org.finos.morphir.intelligence.buildinfo"
  override def buildInfoObjectName = "BuildInfo"
  def buildInfoMembers = Seq(
    BuildInfo.Value("version", publishVersion()),
    BuildInfo.Value("scalaVersion", scalaVersion()),
    BuildInfo.Value("buildJvmVersion", System.getProperty("java.version")),
    BuildInfo.Value("buildJvmVendor", System.getProperty("java.vendor"))
  )
}

/** Publishes an extra `-assembly` classifier alongside the regular jar. Used by `morphir.main` (the CLI). */
trait AssemblyPublishInfo extends JavaModule with PublishModule {
  override def extraPublish: T[Seq[PublishInfo]] = Task {
    Seq(PublishInfo(file = assembly(), classifier = Some("assembly"), ivyConfig = "compile"))
  }
}

/** Skips scaladoc generation, publishing an empty docJar instead.
  *
  * Scaladoc generation reliably crashes with a NullPointerException in
  * dotty.tools.scaladoc.translators.SignatureBuilder on JDK 25 - a known upstream dotty bug
  * (https://github.com/scala/scala3/issues/24183), fixed only in Scala 3.9.0+ (we're on 3.8.4).
  * See morphir/CONTRIBUTING.md for details.
  */
trait EmptyDocJar extends JavaModule {
  override def docJar: T[PathRef] = Task {
    PathRef(mill.util.Jvm.createJar(Task.dest / "out.jar", Seq.empty))
  }
}

/** `runtime`'s test module: sources its JSON test fixtures from the compiled `evaluator-tests` Elm project. */
trait RuntimeTests extends TestModule.ZioTest {
  def morphirTestSources = Task {
    examples.`morphir-elm-projects`.`evaluator-tests`.distOutputDirs()
  }

  def morphirTestSourceFiles = Task {
    Lib.findSourceFiles(morphirTestSources(), Seq("json")).collect {
      case path if path.last.startsWith("morphir-") => PathRef(path)
    }
  }
}

/** `tools.js`'s doc-source filtering: scaladoc's JS output ships `.tasty` files needing this narrowing. */
trait ToolsJSDocSources extends ScalaJSModule {
  override def docSources = Task {
    Lib.findSourceFiles(super.docSources(), Seq("tasty"))
      .map(PathRef(_))
  }
}

/** `morphir.jvm`/`morphir.js`'s own mvnDeps — bundled here (rather than copied as YAML literals) so the version
  * pins stay sourced from the single [[millbuild.Deps]] object.
  */
trait MorphirRootMvnDeps extends ScalaModule {
  override def mvnDeps = super.mvnDeps() ++ Seq(
    Deps.org.`scala-lang`.modules.`scala-collection-contrib`,
    Deps.com.beachape.enumeratum,
    Deps.com.lihaoyi.fansi,
    Deps.com.lihaoyi.geny,
    Deps.com.lihaoyi.sourcecode,
    Deps.com.lihaoyi.pprint,
    Deps.dev.zio.`izumi-reflect`,
    Deps.dev.zio.zio,
    Deps.dev.zio.`zio-json`,
    Deps.dev.zio.`zio-prelude`,
    Deps.org.typelevel.spire,
    Deps.com.softwaremill.magnolia_3.magnolia
  )
}

/** `morphir.main`'s (the CLI's) own mvnDeps. */
