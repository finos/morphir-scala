/**
 * The version of Scala natively supported by the toolchain. Morphir itself may provide backends that generate code for
 * other Scala versions.
 */
val morphirScalaVersion: String = ScalaVers.scala3

val docsScalaVersion: String = ScalaVers.scala3

// Get workspace dir from the build context
val workspaceDir = mill.api.BuildCtx.workspaceRoot

def showBuildSettings() = Task.Command {
  println(s"morphirScalaVersion: ${morphirScalaVersion}")
  println(s"docsScalaVersion: ${docsScalaVersion}")
  println(s"scalaJSVersion: ${ScalaVers.scalaJSVersion}")
  println(s"scalaNativeVersion: ${ScalaVers.scalaNativeVersion}")
  ()
}

object scoverage extends ScoverageReport {
  // While the plugin doesn't seem to support multiple scala versions, that doesn't seem to impact the coverage
  // For overall coverage report, just specifying Scala 3
  def scalaVersion     = ScalaVers.scala3x
  def scoverageVersion = Vers.scoverage
}

/**
 * An independently versioned area: a changelog supplies the release line, git supplies the
 * pre-release markers, and the tag namespace keeps this stream's tags apart from every other's.
 *
 * The configuration members are Tasks rather than plain defs so a `package.mill.yaml` can set them
 * with literals, the same way `ci/package.mill.yaml` sets `libraryModulePrefix` and `uploadJobs`.
 * Both are `Option`-typed: the root area genuinely has no namespace and an area may genuinely have
 * no floor, and a `""` sentinel would only create a case someone forgets to handle.
 */
trait MorphirVersionedModule extends Module {
  import org.finos.morphir.mill.publish.version.*

  /** None is the root stream, tagged `v*`. Some("desktop") is tagged `desktop/v*`. */
  def versionNamespace = Task { Option.empty[String] }

  /** Optional floor; the changelog's release line may not regress below it. */
  def startingVersion = Task { Option.empty[String] }

  /**
   * The area's changelog.
   *
   * A `Task.Source` for two reasons: Mill then invalidates the version when someone edits a release
   * line, and reading the file is legal under Mill's execution-time filesystem checker, which
   * rejects undeclared reads inside a plain `Task`.
   *
   * The libraries' changelog lives at the repository root, not per-module, so the default reads from
   * there; the plugin family and the desktop application override this to their own namespaced file.
   */
  def changelog = Task.Source(mill.api.BuildCtx.workspaceRoot / "CHANGELOG.md")

  /**
   * A cheap, always-fresh fingerprint of the working copy: HEAD, whether the tree is dirty, the full
   * tag list, and the current branch.
   *
   * This exists to invalidate [[gitState]]. Git state changes without any file in the module
   * changing, so something has to be re-read every run — but a `Task.Input` body may not call
   * another task (`allowTaskReferences = false`), so it cannot know the namespace. HEAD and the
   * dirty flag are not enough on their own: creating or deleting a tag at the current commit changes
   * neither, and that is precisely what happens when someone cuts a release. The tag list closes
   * that hole. It is deliberately unfiltered — namespace-independent, same as the rest of this
   * fingerprint — and kept as the raw `git tag --list` text rather than a digest of it: this
   * repository has few tags today, so hashing would only obscure the value for no benefit.
   * Over-invalidating merely costs a recomputation; under-invalidating would publish the wrong
   * version. The branch is namespace-independent too, and rides along here for the same reason —
   * [[streamVersion]] needs it to infer a snapshot when no publish mode is set.
   */
  def gitFingerprint = Task.Input {
    val root = mill.api.BuildCtx.workspaceRoot
    def git(args: String*): String = {
      val result = os.proc("git" +: args).call(cwd = root, check = false, stdout = os.Pipe, stderr = os.Pipe)
      if (result.exitCode != 0)
        throw new IllegalStateException(
          s"git ${args.mkString(" ")} failed (exit ${result.exitCode}): ${result.err.text().trim}"
        )
      result.out.text().trim
    }
    (
      git("rev-parse", "HEAD"),
      git("status", "--porcelain").nonEmpty,
      git("tag", "--list"),
      git("rev-parse", "--abbrev-ref", "HEAD")
    )
  }

  /** Git state for this area's stream, recomputed whenever [[gitFingerprint]] moves. */
  def gitState = Task {
    gitFingerprint() // dependency: this is what makes the cache honest
    GitStream
      .resolve(mill.api.BuildCtx.workspaceRoot, TagStream(versionNamespace()))
      .fold(message => throw new IllegalStateException(message), identity)
  }

  /** The current branch, e.g. for a snapshot qualifier when no publish mode is set. A detached HEAD
    * reports the literal `HEAD`, which normalises to a usable qualifier same as any other name.
    */
  def gitBranch = Task {
    gitFingerprint()._4
  }

  def publishMode = Task.Input {
    Seq("MORPHIR_PUBLISH_MODE", "MORPHIR_PUBLISH_BRANCH")
      .flatMap(name => Task.env.get(name).map(name -> _))
      .toMap
  }

  /** The version this area publishes. */
  def streamVersion = Task {
    val source = changelog().path
    if (!os.exists(source))
      throw new IllegalStateException(
        s"$source: an independently versioned area requires a changelog"
      )
    val text   = os.read(source)
    val stream = TagStream(versionNamespace())
    val state  = gitState()
    val result = for {
      line    <- Changelog.releaseLine(text, source.toString)
      mode    <- StreamVersion.resolveMode(publishMode(), state, stream, line, gitBranch())
      version <- StreamVersion.compose(line, startingVersion(), state, mode, stream)
    } yield version
    result.fold(message => throw new IllegalArgumentException(message), identity)
  }
}

/**
 * Version and POM policy shared by every Morphir publishable, including the desktop distributions,
 * which are not JVM libraries and must not carry Mima.
 */
trait MorphirPublishBase extends PublishModule with SonatypeCentralPublishModule with MorphirVersionedModule {
  import mill.scalalib.publish.*

  /** The area's own stream version. See [[MorphirVersionedModule]]. */
  def publishVersion = Task { streamVersion() }

  def packageDescription: String = s"The $artifactName package"
  def pomSettings                = PomSettings(
    description = packageDescription,
    organization = "org.finos.morphir",
    url = "https://github.com/finos/morphir-scala",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("finos", "morphir-scala"),
    developers = Seq(
      Developer("DamianReeves", "Damian Reeves", "https://github.com/damianreeves")
    )
  )
}

trait MorphirPublishModule extends MorphirPublishBase with JavaModule with Mima

trait MorphirIntelligencePublishModule extends MorphirPublishModule {
  import mill.scalalib.publish.*
  override def pomSettings = super.pomSettings().copy(organization = "org.finos.morphir.intelligence")
}

trait MorphirMillPublishModule extends MorphirPublishModule {
  import mill.scalalib.publish.*
  override def pomSettings = super.pomSettings().copy(organization = "org.finos.morphir.mill")
}

trait MorphirCommonModule extends ScalaModule with CommonScalaModule with MorphirSuiteBom {
  def scalaVersion: T[String]      = Task { morphirScalaVersion }
  def semanticDbVersion: T[String] = Task { Vers.semanticDb }

  def compilerPluginDependencies(selectedScalaVersion: String) =
    Seq(Deps.org.`scala-lang`.`scala3-compiler`(selectedScalaVersion))
}

trait DeduplicatedSources extends ScalaModule {
  override def sources: T[Seq[PathRef]] = Task {
    super.sources().distinctBy(_.path)
  }
}

trait MorphirCommonCrossModule extends CrossPlatformScalaModule with ScalafmtModule with DeduplicatedSources
    with MorphirSuiteBom {
  def scalaVersion                                             = Task { morphirScalaVersion }
  def semanticDbVersion: T[String]                             = Task { Vers.semanticDb }
  def compilerPluginDependencies(selectedScalaVersion: String) =
    Seq(Deps.org.`scala-lang`.`scala3-compiler`(selectedScalaVersion))
}

trait MorphirJVMModule extends MorphirCommonCrossModule {
  def platform = Platform.JVM
}

trait MorphirJSModule extends MorphirCommonCrossModule with ScalaJSModule {
  import mill.scalajslib.api.*
  def platform       = Platform.JS
  def scalaJSVersion = Task { ScalaVers.scalaJSVersion }

  /** YAML `group::artifact` (no version, one colon-pair) parses as non-platformed. Bind library coords as
    * platformed so extra suite jars resolve to the Scala.js artifact, not the JVM jar. Compiler and scalac-plugin
    * coords stay unplatformed: `scala3-compiler_sjs1_3` does not exist. Mill's `resolvedDepsWarnNonPlatform` check
    * runs on the unbound coords and would false-positive after this bind.
    */
  override def bindDependency: Task[Dep => BoundDep] = Task.Anon { (dep: Dep) =>
    super.bindDependency()(platformScalaDep(dep))
  }
  override def resolvedDepsWarnNonPlatform: T[Boolean] = Task { false }
}

/**
 * Scala.js linker config for modules whose runtime reaches Node builtins (`node:fs`, `node:net`, `node:tls`).
 * kyo-http's JS backend is Node-only. Mill's default `ModuleKind.NoModule` cannot import those modules; Kyo's own
 * JS build sets CommonJS for the same reason. Mix this in after [[MorphirJSModule]] so the override wins.
 * Mill's `ScalaJSTests` forwards `moduleKind` from the enclosing module.
 */
trait MorphirJSNodeModule extends ScalaJSModule {
  import mill.scalajslib.api.*
  override def moduleKind: T[ModuleKind] = Task { ModuleKind.CommonJSModule }
}

/**
 * Opt into `-Yretain-trees`. Off by default: under that flag Kyo's TagMacro MatchErrors on `Maybe`
 * (https://github.com/getkyo/kyo/issues/1883), which breaks `Schema.rename` / `@rename` on `Maybe` fields.
 * Mill's `ScalaTests` forwards `scalacOptions` from the outer module, so test objects inherit this automatically.
 */
trait MorphirRetainTrees extends ScalaModule {
  override def scalacOptions: T[Seq[String]] = Task {
    val options = super.scalacOptions()
    if options.contains("-Yretain-trees") then options else options :+ "-Yretain-trees"
  }
}

trait MorphirNativeModule extends MorphirCommonCrossModule with ScalaNativeModule {
  def platform           = Platform.Native
  def scalaNativeVersion = Task { ScalaVers.scalaNativeVersion }

  /** Same as [[MorphirJSModule.bindDependency]]: versionless YAML Scala coords must bind as platformed. */
  override def bindDependency: Task[Dep => BoundDep] = Task.Anon { (dep: Dep) =>
    super.bindDependency()(platformScalaDep(dep))
  }
  override def resolvedDepsWarnNonPlatform: T[Boolean] = Task { false }
}

/**
 * Linker configuration that switches a Scala.js module onto the experimental WebAssembly backend, so it emits a Wasm
 * GC binary plus an ES-module JS loader instead of plain JS.
 *
 * The backend requires `ModuleKind.ESModule` and ES2022; both are set here so callers only mix the trait in. Output
 * loads in browsers with Wasm GC (Chrome 119+, Firefox 120+, Safari 18.2+) and on Node 22+.
 *
 * Mix this into a module's *test* object as well as the module itself: Mill's `ScalaJSTests` forwards `moduleKind`
 * and `esFeatures` from the enclosing module but not `scalaJSExperimentalUseWebAssembly`, so without it the tests
 * would silently link as plain JS and duplicate the `js` module's test run.
 *
 * @note
 *   The WebAssembly backend treats `@JSExport*` annotations differently from the JS linker: `@JSExport` on
 *   object/class members is silently dropped, and `@JSExportTopLevel` on an `object` yields an ES-module export with
 *   no members. `@JSExportTopLevel` on a top-level `val` IS honored, so FFI surfaces that need a populated namespace
 *   should be exposed as `@JSExportTopLevel("Name") val foo: js.Object = js.Dynamic.literal(...)`.
 */
trait MorphirWasmLinker extends ScalaJSModule with mill.scalajslib.config.ScalaJSConfigModule {
  import mill.scalajslib.api.*
  override def scalaJSExperimentalUseWebAssembly: T[Boolean] = Task(true)
  override def moduleKind: T[ModuleKind]                     = Task { ModuleKind.ESModule }

  // ES2022 has to be set through Scala.js' own linker API: Mill's `ESVersion` enum stops at ES2021, which is why the
  // whole `ScalaJSConfigModule` detour (and its three metabuild deps at the top of this file) exists at all.
  // Note that mixing it in makes `scalaJSVersion` final at the linker dep's version — keep the `org.scala-js:
  // scalajs-linker_2.13` metabuild coordinate in step with `ScalaVers.scalaJSVersion`.
  override def scalaJSConfig: Task[org.scalajs.linker.interface.StandardConfig] = Task.Anon {
    super.scalaJSConfig().withESFeatures(
      _.withESVersion(org.scalajs.linker.interface.ESVersion.ES2022).withUseWebAssembly(true)
    )
  }

  // Scala.js compiles exception handling to the Wasm `exnref` type, which Node still hides behind a flag
  // ("invalid value type 'exn', enable with --experimental-wasm-exnref"). Browsers with Wasm GC need no equivalent.
  override def jsEnvConfig: T[JsEnvConfig] = Task {
    JsEnvConfig.NodeJs(args = List("--experimental-wasm-exnref"))
  }
}

/**
 * Scala.js module variant linked through the WebAssembly backend — see [[MorphirWasmLinker]] for the linker config.
 *
 * It is a link-output variant of [[MorphirJSModule]], not a fourth platform: `platform` stays [[Platform.JS]], so a
 * Wasm module compiles the very same `src` / `js/src` trees as its `js` sibling. Consequently a Wasm module's
 * `moduleDeps` should point at the `js` modules of its dependencies.
 */
trait MorphirWasmModule extends MorphirJSModule with MorphirWasmLinker

/**
 * Test-side counterpart of [[MorphirWasmModule]], to be mixed into a Wasm module's test object alongside
 * `ScalaJSTests`.
 *
 * Mill's `ScalaJSTests` forwards `moduleKind` and `esFeatures` from the enclosing module but links tests through its
 * own `testLinkTask`, which ignores `scalaJSConfig`. Without this trait a Wasm module's tests link as plain JS —
 * silently duplicating the `js` module's run rather than exercising the Wasm output.
 */
trait MorphirWasmTests extends mill.scalajslib.config.TestScalaJSConfigModule with MorphirWasmLinker

/**
 * Turns Scala.js source maps off for a test link.
 *
 * Mill's `ScalaJSModule` defaults `scalaJSSourceMap` to `true` (verified against the pinned Mill
 * 1.2.0-RC1-46-16168f sources), and `ScalaJSTests` does not override it — a test object gets its own
 * `true` independent of the module it tests. CI's `test-js` job OOM'd inside the source-map printer
 * itself: `org.scalajs.linker.backend.javascript.Printers$JSTreePrinterWithSourceMap.print`, called
 * from `ByteArrayWriter.ensureCapacity` (morphir-oyn). Nothing in CI reads a test link's source map,
 * so turning it off there removes real linker work rather than trading one failure for another.
 *
 * Scoped to test objects only — mix this into `object test:`'s `extends:` list, not the module
 * itself. A published `js`/`wasm` module keeps its source map for downstream debugging; only the
 * `.test` submodule's own link is affected. Mix in after `ScalaJSTests` (and, for a Wasm test
 * object, after [[MorphirWasmTests]] too) so this override wins — the same linearization
 * [[MorphirWasmTests]] already relies on for `scalaJSExperimentalUseWebAssembly`.
 *
 * If OOMs return after this is turned back on, this is the frame to look at first.
 */
trait MorphirJSTestNoSourceMap extends ScalaJSModule {
  override def scalaJSSourceMap: T[Boolean] = Task { false }
}

/** Shared BuildInfo wiring: version + scalaVersion members. Requires [[PublishModule]] + [[ScalaModule]].
  *
  * Extracted to the metabuild because it's mixed in from per-directory `package.mill`/`package.mill.yaml` files —
  * their own `moduleDir`-relative source computations can't statically see other directories' modules, but a named
  * trait like this one resolves fine via `extends:` regardless of which file references it.
  */
trait MorphirVersionBuildInfo extends BuildInfo with PublishModule with ScalaModule {
  def buildInfoMembers = Seq(
    BuildInfo.Value("version", publishVersion()),
    BuildInfo.Value("scalaVersion", scalaVersion())
  )
}

/** [[MorphirVersionBuildInfo]] variant that also reports the cross-platform target (jvm/js/native). */
trait MorphirPlatformBuildInfo extends MorphirVersionBuildInfo {
  def platform: Platform
  override def buildInfoMembers = Task { super.buildInfoMembers() ++ Seq(
    BuildInfo.Value("platform", platform.toString)
  ) }
}

/** [[MorphirPlatformBuildInfo]] for `extensibility` — `buildInfoPackageName` hardcoded here rather than left for
  * per-leaf YAML override, since overriding plain (non-Task) BuildInfo members via YAML `extends:` chains didn't
  * take effect in practice (Mill 1.2.0-RC1) — worth re-checking against a later Mill release.
  */
trait MorphirExtensibilityBuildInfo extends MorphirPlatformBuildInfo {
  def buildInfoPackageName = "org.finos.morphir.extensibility"
}

/** [[MorphirVersionBuildInfo]] for `morphir.main` (the CLI) — see [[MorphirExtensibilityBuildInfo]] for why this is
  * hardcoded rather than YAML-overridden.
  */
trait MorphirCliBuildInfo extends MorphirVersionBuildInfo {
  def buildInfoPackageName = "org.finos.morphir.cli"
}

/** BuildInfo wiring for `morphir.intelligence` — its own member set (adds JVM build info, no `platform` member
  * since this module isn't cross-platform) and package name, both hardcoded per [[MorphirExtensibilityBuildInfo]].
  *
  * Intentionally does **not** extend [[PublishModule]]. Intelligence is unpublished (#950); mixing in
  * `PublishModule` typed `moduleDeps` as `Seq[PublishModule]` and broke Graph/generate once the SDK lost
  * its publish trait while remaining a module dependency of this CLI.
  *
  * [[MorphirVersionedModule]] only needs `Module`, not `PublishModule`, so mixing it in here for
  * [[intelligenceVersion]] does not reintroduce that problem. It takes the trait's defaults — the root
  * stream (`versionNamespace = None`), the repository's own `CHANGELOG.md` — the same stream the
  * libraries publish under, which is what the old env-driven `SnapshotVersion` selection also read.
  */
trait MorphirIntelligenceBuildInfo extends BuildInfo with ScalaModule with MorphirVersionedModule {
  def buildInfoPackageName = "org.finos.morphir.intelligence.buildinfo"
  override def buildInfoObjectName = "BuildInfo"

  def intelligenceVersion = Task { streamVersion() }

  def buildInfoMembers = Seq(
    BuildInfo.Value("version", intelligenceVersion()),
    BuildInfo.Value("scalaVersion", scalaVersion()),
    BuildInfo.Value("buildJvmVersion", System.getProperty("java.version")),
    BuildInfo.Value("buildJvmVendor", System.getProperty("java.vendor"))
  )
}

/** Publishes an extra `-assembly` classifier alongside the regular jar. Used by `morphir.main` (the CLI). */
trait AssemblyPublishInfo extends JavaModule with PublishModule {
  override def extraPublish: T[Seq[PublishInfo]] = Task {
    Seq(PublishInfo(file = assembly(), classifier = Some("assembly"), ivyConfig = "compile"))
  }
}

/** Skips scaladoc generation, publishing an empty docJar instead.
  *
  * Scaladoc generation reliably crashes with a NullPointerException in
  * dotty.tools.scaladoc.translators.SignatureBuilder on JDK 25 - a known upstream dotty bug
  * (https://github.com/scala/scala3/issues/24183), fixed only in Scala 3.9.0+ (we're on 3.8.4).
  * See morphir/CONTRIBUTING.md for details.
  *
  * The crash follows the sources, not the platform, so every module compiling the affected sources needs this - the
  * root `morphir` module's `js` variant hit exactly the same NPE as its `jvm` sibling. It surfaced only on a cold
  * cache, and confusingly: after the scaladoc worker dies, the retry reports the missing output directory
  * ("...scalaDocGenerated.dest/javadoc does not exist or is not a directory or .jar file") rather than the NPE, which
  * appears only under `--debug`.
  */
trait EmptyDocJar extends JavaModule {
  override def docJar: T[PathRef] = Task {
    PathRef(mill.util.Jvm.createJar(Task.dest / "out.jar", Seq.empty))
  }
}

/** Generates typed JVM-only paths to the seven Morphir IR fixtures used by the classic runtime tests. */
trait ClassicRuntimeTestFixtures extends ScalaModule {
  def generatedRuntimeFixtures: T[PathRef] = Task {
    val evaluator = build.examples.`morphir-elm-projects`.`evaluator-tests`.morphirIR()
    val defaults  = build.examples.`morphir-elm-projects`.`defaults-tests`.morphirIR()
    val unitTestFramework = build.`morphir-elm`.sdks.`morphir-unit-test`.morphirIR()
    val unitTestExample =
      build.examples.`morphir-elm-projects`.`unit-test-framework`.`example-project`.morphirIR()
    val unitTestFailing =
      build.examples.`morphir-elm-projects`.`unit-test-framework`.`example-project-tests`.morphirIR()
    val unitTestPassing =
      build.examples.`morphir-elm-projects`.`unit-test-framework`.`example-project-tests-passing`.morphirIR()
    val unitTestIncomplete =
      build.examples.`morphir-elm-projects`.`unit-test-framework`.`example-project-tests-incomplete`.morphirIR()

    val fixtures = ClassicRuntimeFixtureSet(
      evaluator = evaluator,
      defaults = defaults,
      unitTestFramework = unitTestFramework,
      unitTestExample = unitTestExample,
      unitTestFailing = unitTestFailing,
      unitTestPassing = unitTestPassing,
      unitTestIncomplete = unitTestIncomplete
    )
    val packageDirectory = Task.dest / "org" / "finos" / "morphir" / "runtime" / "fixtures"
    os.makeDir.all(packageDirectory)
    os.write.over(
      packageDirectory / "GeneratedRuntimeFixtures.scala",
      ClassicRuntimeFixtureSource.render(fixtures)
    )
    PathRef(Task.dest)
  }

  override def generatedSources: T[Seq[PathRef]] = Task {
    super.generatedSources() :+ generatedRuntimeFixtures()
  }
}

/** Fails fast when any generated-fixture-backed classic runtime suite drops out of Mill test discovery. */
trait ClassicRuntimeTestDiscovery extends mill.javalib.TestModule {
  def verifyRuntimeTestDiscovery: T[Unit] = Task {
    RuntimeTestDiscovery.requireAllDiscovered(discoveredTestClasses())
  }
}

/** `model.lowering`'s differential test (`RealIrCodecRoundTripSpec`) reads its real-IR fixture from the tracked
  * `evaluator-tests` example output (`examples/morphir-elm-projects/evaluator-tests/morphir-ir2.json`) rather than
  * keeping a byte-identical duplicate under `test/resources` - two copies would silently drift the next time the
  * example is regenerated. The fixture is copied (not symlinked, for portability across OSes and IDEs) into a
  * synthesized resource directory on every build, so the tracked file stays the single source of truth and the rest
  * of the `evaluator-tests` Elm project isn't exposed as a resource root.
  */
trait LoweringRealIrFixture extends JavaModule {
  def realIrFixtureSource: T[PathRef] = Task.Source(
    build.examples.`morphir-elm-projects`.`evaluator-tests`.moduleDir / "morphir-ir2.json"
  )

  override def resources: T[Seq[PathRef]] = Task {
    val fixtureDir = Task.dest / "resources"
    os.makeDir.all(fixtureDir)
    os.copy.over(realIrFixtureSource().path, fixtureDir / "morphir-ir2.json")
    super.resources() :+ PathRef(fixtureDir)
  }
}

/** `tools.js`'s doc-source filtering: scaladoc's JS output ships `.tasty` files needing this narrowing. */
trait ToolsJSDocSources extends ScalaJSModule {
  override def docSources = Task {
    Lib.findSourceFiles(super.docSources(), Seq("tasty"))
      .map(PathRef(_))
  }
}

/** Bind a Scala binary/full-cross dep as platformed. YAML `group::artifact` (empty version) parses as
  * `CrossVersion.Binary(platformed = false)`; without this, JS and Native silently resolve the JVM jar.
  * Java coords (`group:artifact`) are `Constant` and are left alone. Compiler and scalac-plugin artifacts are
  * not published as platformed jars, so they stay as Mill declared them.
  */
def platformScalaDep(dep: Dep): Dep =
  if isCompilerOrPluginDep(dep) then dep
  else
    dep.cross match
      case mill.api.CrossVersion.Binary(false) =>
        dep.copy(cross = mill.api.CrossVersion.Binary(true))
      case mill.api.CrossVersion.Full(false) =>
        dep.copy(cross = mill.api.CrossVersion.Full(true))
      case _ => dep

def isCompilerOrPluginDep(dep: Dep): Boolean =
  val org  = dep.dep.module.organization.value
  val name = dep.dep.module.name.value
  (org == "org.scala-lang" &&
    (name.contains("compiler") || name.contains("scaladoc") || name.contains("tasty-inspector"))) ||
  (org == "org.scala-js" && name.contains("compiler")) ||
  (org == "org.scala-native" && (name == "nscplugin" || name.contains("compiler")))

/** Pins every known library suite (kyo, zio, fs2, upickle, borer, metaconfig, scala-java-time) through Mill
  * `depManagement`. Each suite's version lives once in [[millbuild.Versions]]. Extra suite jars belong in YAML
  * `mvnDeps: !append` without a version. Do not add a new trait per artifact.
  */
trait MorphirSuiteBom extends ScalaModule {
  override def depManagement = super.depManagement() ++ Deps.managedSuites
}

/** The base kyo effect deps — what a module needs to write `ArrowEffect`s and run them. Used by the `langkit`
  * modules, whose production code is Kyo-native. The version pin lives on [[MorphirSuiteBom]]; this trait only
  * *fetches* kyo-core and kyo-prelude. Extra kyo artifacts go in YAML `mvnDeps: !append` with no version.
  */
trait MorphirKyoCoreMvnDeps extends ScalaModule {
  override def mvnDeps = super.mvnDeps() ++ Seq(
    Deps.io.getkyo.`kyo-core`,
    Deps.io.getkyo.`kyo-prelude`
  )
}

/** `kyo-schema` on its own, for modules that derive schemas without needing kyo-data's containers. */
trait MorphirKyoSchemaMvnDeps extends ScalaModule {
  override def mvnDeps = super.mvnDeps() ++ Seq(
    Deps.io.getkyo.`kyo-schema`
  )
}

/** `kyo-case-app`, the CLI argument parser behind `morphir.intelligence`'s entry point. */
trait MorphirKyoCaseAppMvnDeps extends ScalaModule {
  override def mvnDeps = super.mvnDeps() ++ Seq(
    Deps.io.getkyo.`kyo-case-app`
  )
}

/** kyo deps for `morphir.model`. */
trait MorphirKyoMvnDeps extends ScalaModule {
  override def mvnDeps = super.mvnDeps() ++ Seq(
    Deps.io.getkyo.`kyo-data`,
    Deps.io.getkyo.`kyo-schema`
  )
}

/** kyo-test deps. kyo-test's Mill traits set only the framework class, so each test block
  * must declare these itself. */
trait MorphirKyoTestMvnDeps extends ScalaModule {
  override def mvnDeps = super.mvnDeps() ++ Seq(
    Deps.io.getkyo.`kyo-core`,
    Deps.io.getkyo.`kyo-prelude`,
    Deps.io.getkyo.`kyo-test-api`,
    Deps.io.getkyo.`kyo-test-runner`
  )
}

/** Opt-in kyo-test snapshot and golden assertions. Mix into a test module that extends `SnapshotTest`. */
trait MorphirKyoSnapshotTestMvnDeps extends ScalaModule {
  override def mvnDeps = super.mvnDeps() ++ Seq(
    Deps.io.getkyo.`kyo-test-snapshot`,
    Deps.io.getkyo.`kyo-test-prop`
  )
}

/** The `kyo-schema` JSON codec (`kyo.Json`), published as a separate artifact from `kyo-schema` itself. Needed
  * wherever a derived `Schema` is round-tripped through `encodeString`/`decodeString`, whether that's production
  * code (e.g. `morphir.model`'s `CodeModelCodecs`) or a test. */
trait MorphirKyoSchemaJsonMvnDeps extends ScalaModule {
  override def mvnDeps = super.mvnDeps() ++ Seq(
    Deps.io.getkyo.`kyo-schema-json`
  )
}

/** Absolute kyo-test snapshot directory for the GitHub connector. Mill's test sandbox would otherwise swallow relative paths. */
def githubConnectorSnapshotDir: String =
  (workspaceDir / "morphir" / "connector" / "github" / "test-snapshots").toNIO.toAbsolutePath.normalize.toString

trait MorphirConnectorGithubSnapshotEnv extends ScalaModule {
  override def forkEnv: T[Map[String, String]] = Task {
    super.forkEnv() ++ Map("MORPHIR_CONNECTOR_GITHUB_SNAPSHOT_DIR" -> githubConnectorSnapshotDir)
  }
}

/** Passes the GitHub connector snapshot directory into Node, which does not inherit [[TestModule.forkEnv]]. */
trait MorphirConnectorGithubSnapshotJsEnv extends ScalaJSModule {
  import mill.scalajslib.api.JsEnvConfig
  override def jsEnvConfig: T[JsEnvConfig] = Task {
    val extra = Map("MORPHIR_CONNECTOR_GITHUB_SNAPSHOT_DIR" -> githubConnectorSnapshotDir)
    super.jsEnvConfig() match
      case node: JsEnvConfig.NodeJs => node.copy(env = node.env ++ extra)
      case other                    => other
  }
}

/** `caliban-client` for typed GraphQL documents. ZIO-free at compile time. Codegen is a Mill script, not a module dep. */
trait MorphirCalibanClientMvnDeps extends ScalaModule {
  override def mvnDeps = super.mvnDeps() ++ Seq(
    Deps.com.github.ghostdogpr.`caliban-client`
  )
}

