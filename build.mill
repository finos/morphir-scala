}

/** `tests.js.test`/`runtime.js.test`'s mvnDeps. */
trait MorphirTestsTestMvnDepsJS extends ScalaModule {
  override def mvnDeps = super.mvnDeps() ++ Seq(
    Deps.dev.zio.`zio-test`,
    Deps.dev.zio.`zio-test-sbt`
  )
