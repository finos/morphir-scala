package build.`mill-plugins`.morphir

import mill.*, mill.scalalib.*
import mill.api.TaskCtx
import mill.scalalib.publish.{Artifact, LocalM2Publisher, Pom, PublishInfo}
import mill.scalalib.scalafmt.ScalafmtModule
import millbuild.{Deps, MillVersions, Versions => Vers, ScalaVersions => ScalaVers}
import build.MorphirMillPublishModule

val PublishedTestVersion = "0.0.0-published-test-SNAPSHOT"

trait MorphirMillPlugin extends Cross.Module[String] with ScalaModule with ScalafmtModule
    with MorphirMillPublishModule {
  def millVersion = crossValue

  def scalaVersion            = ScalaVers.scala3
  override def platformSuffix = MillVersions.platformSuffix
  override def compileMvnDeps = super.compileMvnDeps() ++ Seq(
    mvn"com.lihaoyi::mill-libs-scalalib:$millVersion"
  )
  override def scalacOptions = Seq("-Wunused:all", "-deprecation")

  /**
   * A task-local Maven repository for fresh-consumer tests.
   *
   * This follows Mill's own plugin-test pattern: publish the ordinary compiled jar under a fixed SNAPSHOT coordinate
   * and rewrite repository-local module dependencies to the same version. Normal publication keeps using the VCS
   * version from [[MorphirMillPublishModule]].
   */
  override def publishLocalTestRepo: Task[PathRef] = Task {
    def snapshot(artifact: Artifact): Artifact =
      if (artifact.group == "org.finos.morphir.mill") artifact.copy(version = PublishedTestVersion)
      else artifact

    val artifact = Artifact(pomSettings().organization, artifactId(), PublishedTestVersion)
    val pomText  = Pom(
      artifact,
      publishXmlDeps().map(dependency => dependency.copy(artifact = snapshot(dependency.artifact))),
      artifactId(),
      pomSettings(),
      publishProperties(),
      packagingType = pomPackagingType,
      parentProject = pomParentProject().map(snapshot),
      bomDependencies = publishXmlBomDeps().map(dependency =>
        dependency.copy(artifact = snapshot(dependency.artifact))
      ),
      dependencyManagement = publishXmlDepMgmt().map(dependency =>
        dependency.copy(artifact = snapshot(dependency.artifact))
      )
    )
    val pomPath = Task.dest / s"${artifact.id}-${artifact.version}.pom"
    os.write.over(pomPath, pomText)
    LocalM2Publisher(Task.dest).publish(
      pomPath,
      artifact,
      defaultPublishInfos(sources = false, docs = false)() ++
        Seq(PublishInfo.sourcesJar(sourceJar())) ++ extraPublish()
    )(using
      new TaskCtx.Log {
        override def log: mill.api.daemon.Logger = mill.api.Logger.DummyLogger
      }
    )
    os.remove(pomPath)
    PathRef(Task.dest)
  }
}

object toolchain extends Cross[ToolchainPlugin](MillVersions.all)

trait ToolchainPlugin extends MorphirMillPlugin {
  override def artifactName       = "mill-morphir-toolchain"
  override def packageDescription = "Verified tool acquisition and platform support for Mill Morphir plugins."
  override def mvnDeps            = super.mvnDeps() ++ Seq(
    Deps.com.lihaoyi.osLibJvm,
    Deps.com.lihaoyi.upickleJvm,
    Deps.org.apache.commons.`commons-compress`
  )
  override protected def resolvedDepsWarnNonPlatform = false

  object test extends ScalaTests with TestModule.Utest with ScalafmtModule {
    def utestVersion = Vers.utest
  }
}

object javascript extends Cross[JavaScriptPlugin](MillVersions.all)

trait JavaScriptPlugin extends MorphirMillPlugin {
  override def artifactName       = "mill-morphir-javascript"
  override def packageDescription = "JavaScript runtime and package-manager support for Mill Morphir plugins."
  override def moduleDeps         = Seq(toolchain(crossValue))
  override def mvnDeps            = super.mvnDeps() ++ Seq(Deps.com.lihaoyi.sourcecodeJvm)
  override protected def resolvedDepsWarnNonPlatform = false

  object test extends ScalaTests with TestModule.Utest with ScalafmtModule {
    def utestVersion       = Vers.utest
    override def resources = Task.Sources(moduleDir / "fixtures")
    override def mvnDeps   = super.mvnDeps() ++ Seq(
      mvn"com.lihaoyi::mill-libs-scalalib:${JavaScriptPlugin.this.millVersion}",
      mvn"com.lihaoyi::mill-testkit:${JavaScriptPlugin.this.millVersion}"
    )
  }
}

