object elm extends Cross[ElmPlugin](MillVersions.all)

trait ElmPlugin extends MorphirMillPlugin {
  override def artifactName       = "mill-morphir-elm"
  override def packageDescription = "Morphir IR generation from Elm projects in Mill."
  override def moduleDeps         = Seq(core(crossValue), `elm-tooling`(crossValue))

  object test extends ScalaTests with TestModule.Utest with ScalafmtModule {
    def utestVersion       = Vers.utest
    override def resources = Task.Sources(moduleDir / "resources", moduleDir / os.up / "test-tools")
    override def sources   = Task.Sources(
      moduleDir / "src",
      mill.api.BuildCtx.workspaceRoot / "mill-build" / "src" / "org" / "finos" / "millmorphir" /
        "MorphirModule.scala",
      mill.api.BuildCtx.workspaceRoot / "mill-build" / "src" / "org" / "finos" / "millmorphir" / "elm" /
        "MorphirElmModule.scala"
    )
    override def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"com.lihaoyi::mill-libs-scalalib:${ElmPlugin.this.millVersion}",
      mvn"com.lihaoyi::mill-testkit:${ElmPlugin.this.millVersion}"
    )
  }
}

object integration extends ScalaModule with ScalafmtModule {
  def scalaVersion = ScalaVers.scala3
  def moduleDeps   = Seq(core(MillVersions.oldest))

  object millExecutable extends JavaModule {
    def mvnDeps   = Seq(mvn"com.lihaoyi:mill-runner-launcher_3:${MillVersions.oldest}")
    def mainClass = Some("mill.launcher.MillLauncherMain")
  }

  def publishedPluginRepositories: T[Seq[PathRef]] = Task {
    Seq(
      toolchain(MillVersions.oldest).publishLocalTestRepo(),
      javascript(MillVersions.oldest).publishLocalTestRepo(),
      `elm-tooling`(MillVersions.oldest).publishLocalTestRepo(),
      core(MillVersions.oldest).publishLocalTestRepo(),
      elm(MillVersions.oldest).publishLocalTestRepo()
    )
  }

  def publishedConsumerInputs: T[PathRef] = Task {
    val root       = Task.dest / "published-consumer-inputs"
    val repository = root / "repository"
    os.makeDir.all(repository)
    publishedPluginRepositories().foreach { source =>
      os.copy.into(
        source.path / "org",
        repository,
        followLinks = true,
        replaceExisting = true,
        copyAttributes = true,
        createFolders = true,
        mergeFolders = true
      )
    }
    os.copy.over(millExecutable.assembly().path, root / "mill-executable.jar")
    PathRef(root)
  }

  object test extends ScalaTests with TestModule.Utest with ScalafmtModule {
    def utestVersion       = Vers.utest
    def fixtureResources   = Task.Sources(moduleDir / os.up / "resources")
    override def resources = Task {
      fixtureResources() :+ integration.publishedConsumerInputs()
    }
    override def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"com.lihaoyi::mill-testkit:${MillVersions.oldest}"
    )
  }
}
