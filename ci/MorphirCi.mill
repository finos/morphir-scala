package build.ci

import build.MorphirVersionedModule
import build.{`mill-plugins` => millPlugins}
import build.{morphir => morphirArea}
import build.morphir.{desktop => desktopArea}
import mill.*
import mill.api.{BuildCtx, DefaultTaskModule, Evaluator, ModuleRef, Result, SelectMode, TaskCtx}
import millbuild.{JsTestSelectors, LintSelectors, MillVersions}
import org.finos.morphir.mill.publish.{MillPublishEnvFile, MillSonatypeEnv, PgpSecret, PublishSelectors}
import org.finos.morphir.mill.publish.desktop.{
  DesktopPlatform,
  DesktopRelease,
  DesktopReleaseChecks,
  DesktopReleaseLayout,
  ReleaseSnapshot,
  ReleaseVerifier
}

/** One independently versioned area, as [[MorphirCiModule.releaseAreas]] reports it. */
case class ReleaseAreaRow(
    name: String,
    namespace: Option[String],
    changelogPath: String,
    startingVersion: Option[String]
)

object ReleaseAreaRow {
  implicit val readWriter: upickle.default.ReadWriter[ReleaseAreaRow] = upickle.default.macroRW
}

/**
 * CI commands that YAML cannot express. Morphir inventory knobs for libraries live in
 * `ci/package.mill.yaml`; publishable Mill plugins are [[pluginModules]] ModuleRefs.
 *
 * Slice 1: [[sonatype]] plus [[lint]]. Slice 2: [[desktop]] — the Morphir desktop application, published
 * to a GitHub Release (archives, installers, checksums) and to Maven Central (archives only, one
 * artifactId per platform, mirroring `mill-dist-native-<os>-<arch>`).
 *
 * Dynamic task selection uses Mill's exclusive [[Evaluator]] commands (same mechanism as builtin
 * `resolve` / `show`). Nested `./mill` is intentionally avoided — under `mill -i` it deadlocks on
 * the workspace write lock.
 *
 * Upload expects `MILL_PGP_*` / `MILL_SONATYPE_*` (or `SONATYPE_*`) already in the Mill process
 * environment. The Release workflow runs `ci.sonatype.writeMillEnv` (GPG_* in that mill's
 * `Task.env`), sources the file, then starts `./mill -i ci.publish` so `Task.env` sees `MILL_*`.
 * Conversion lives in mill-morphir-core (`org.finos.morphir.mill.publish`).
 */
trait MorphirCiModule extends Module {

  /** Module-path prefix for library Sonatype publishables. Set in `package.mill.yaml`. */
  def libraryModulePrefix = Task { "" }

  /** Prefixes never treated as libraries even when [[libraryModulePrefix]] would match. */
  def libraryExcludedPrefixes = Task { Seq.empty[String] }

  /** Drop any module whose Mill path contains one of these substrings. */
  def excludedModuleSubstrings = Task { Seq.empty[String] }

  /**
   * Parallelism for `publishSonatypeCentral`. `1` means serial `evaluator.evaluate` calls
   * (SLF4J / #957). Values greater than 1 evaluate the batch under the outer `--jobs` setting.
   */
  def uploadJobs = Task { 1 }

  /**
   * The independently versioned areas as the build sees them, read from the modules that declare them rather than
   * restated here.
   *
   * `squire changelog check` keeps its own copy of this table, in `SquireChangelog.Areas`, because a Mill script
   * cannot depend on the build. `.config/version-rules/corpus.json` is where the two are pinned together, and this
   * task is what lets a test read the build's side of it without parsing `package.mill`. Raising a floor here and
   * forgetting the port would otherwise leave the CI policy gate validating the old one.
   *
   * Useful on its own: `./mill show ci.releaseAreas` answers "what does the build think it releases, and from which
   * changelog" without reading three files.
   */
  def releaseAreas: T[Seq[ReleaseAreaRow]] = Task {
    Seq(
      releaseAreaRow("libraries", morphirArea.jvm)(),
      releaseAreaRow("mill-plugins", millPlugins.morphir.core(MillVersions.oldest))(),
      releaseAreaRow("desktop", desktopArea.dist.platform(DesktopPlatform.LinuxAmd64.token))()
    )
  }

  /**
   * Reads one module's area declaration. The changelog is reported workspace-relative, since an absolute path names
   * this checkout rather than the repository.
   */
  private def releaseAreaRow(name: String, module: MorphirVersionedModule): Task[ReleaseAreaRow] = Task.Anon {
    ReleaseAreaRow(
      name = name,
      namespace = module.versionNamespace(),
      changelogPath = module.changelog().path.relativeTo(BuildCtx.workspaceRoot).toString,
      startingVersion = module.startingVersion()
    )
  }

  /**
   * Publishable mill-morphir plugin Cross roots. `integration` is omitted (test-only).
   * ModuleRefs keep the inventory type-safe; expand via Evaluator under each root.
   */
  def pluginModules: Seq[ModuleRef[Module]] = Seq(
    ModuleRef(millPlugins.morphir.toolchain),
    ModuleRef(millPlugins.morphir.javascript),
    ModuleRef(millPlugins.morphir.`elm-tooling`),
    ModuleRef(millPlugins.morphir.core),
    ModuleRef(millPlugins.morphir.elm)
  )

  final case class PublishFilterConfig(
      libraryModulePrefix: String,
      libraryExcludedPrefixes: Seq[String],
      excludedModuleSubstrings: Seq[String],
      uploadJobs: Int
  ) derives upickle.default.ReadWriter

  enum PublishKind {
    case Libraries, Plugins, All
  }

  object sonatype extends Module, DefaultTaskModule {
    def defaultTask(): String = "all"

    def artifactsLibraries(evaluator: Evaluator) = Task.Command(exclusive = true) {
      runArtifactPhase(evaluator, PublishKind.Libraries, publishFilterConfig())
    }

    def artifactsPlugins(evaluator: Evaluator) = Task.Command(exclusive = true) {
      runArtifactPhase(evaluator, PublishKind.Plugins, publishFilterConfig())
    }

    def artifacts(evaluator: Evaluator) = Task.Command(exclusive = true) {
      runArtifactPhase(evaluator, PublishKind.All, publishFilterConfig())
    }

    def libraries(evaluator: Evaluator) = Task.Command(exclusive = true) {
      runUploadPhase(evaluator, PublishKind.Libraries, publishFilterConfig())
    }

    def plugins(evaluator: Evaluator) = Task.Command(exclusive = true) {
      runUploadPhase(evaluator, PublishKind.Plugins, publishFilterConfig())
    }

    /**
     * Write `MILL_*` publish env for a later mill process. Values are not logged.
     *
     * GHA: `./mill -i ci.sonatype.writeMillEnv --path "$envfile"` then `source` the file
     * before `./mill -i ci.publish`. `Task.env` is snapshotted at mill start, so conversion
     * inside the publish mill cannot feed `publishSonatypeCentral`.
     */
    def writeMillEnv(path: os.Path) = Task.Command {
      val dest = MillPublishEnvFile.requireWritableDest(path, BuildCtx.workspaceRoot)
      val millEnv = MillSonatypeEnv.fromEnvOrThrow(
        sys.env ++ Task.env,
        msg => Task.log.info(msg)
      )
      PgpSecret.validate(millEnv.pgpSecretBase64, msg => Task.log.info(msg))
      os.write.over(dest, millEnv.toDotenv, createFolders = true, perms = "rw-------")
      Task.log.info(s"Wrote Mill publish env to $dest (values not logged)")
    }

    /** Full Sonatype destination: artifacts then upload. */
    def all(evaluator: Evaluator) = Task.Command(exclusive = true) {
      val cfg = publishFilterConfig()
      runArtifactPhase(evaluator, PublishKind.All, cfg)
      runUploadPhase(evaluator, PublishKind.All, cfg)
    }
  }

  /**
   * Desktop application destination.
   *
   * Packaging runs on native runners and uploads raw electron-builder output; this destination
   * canonicalizes it once, then feeds both hosts. The dist modules are excluded from `ci.publish`
   * (see `excludedModuleSubstrings`) because there is no archive to publish on a snapshot run.
   */
  object desktop extends Module {

    /** Root the CI job downloads per-platform artifacts into: `<root>/<token>/…`. */
    def stagingRootPath = Task.Input {
      Task.env
        .get("MORPHIR_DESKTOP_STAGING_DIR")
        .map(value => os.Path(value, BuildCtx.workspaceRoot))
        .getOrElse(BuildCtx.workspaceRoot / ".dev" / "dist" / "desktop" / "staging")
        .toString
    }

    /** Directory the canonicalized assets are written to; the dist modules read the same path. */
    def releaseDirPath = Task.Input {
      Task.env
        .get("MORPHIR_DESKTOP_RELEASE_DIR")
        .map(value => os.Path(value, BuildCtx.workspaceRoot))
        .getOrElse(BuildCtx.workspaceRoot / ".dev" / "dist" / "desktop" / "release")
        .toString
    }

    /**
     * The desktop area's own stream version — read straight from a `platform[<token>]` dist module
     * rather than recomposed here, so the packaging jobs and the dist modules cannot disagree
     * about what is being built. Every `platform[<token>]` module shares the same
     * [[MorphirVersionedModule]] namespace (`versionNamespace = Some("desktop")`), changelog and tag
     * stream, so the token picked to read it from is arbitrary; `linux-amd64` is used elsewhere in
     * this object as the canonical single-platform default.
     */
    def version = Task {
      desktopArea.dist.platform(DesktopPlatform.LinuxAmd64.token).streamVersion()
    }

    /**
     * Rename staged output to canonical names, write `.sha256` sidecars and `checksums.txt`.
     *
     * Empties the release directory first, so a second run at a different version in the same
     * workspace does not leave the previous version's assets and sidecars behind for
     * `githubRelease` to upload alongside the current ones.
     *
     * `platforms` is a comma-separated token list (`DesktopPlatform.token`), defaulting to all five —
     * the release path. CI packaging a pull request stages only `linux-amd64`, so it passes that one
     * token; `DesktopRelease.canonicalize` would otherwise fail demanding the other four.
     */
    def canonicalize(platforms: String = DesktopPlatform.AllTokens) = Task.Command(exclusive = true) {
      val selected = parsePlatforms(platforms)
      runCanonicalize(os.Path(stagingRootPath()), os.Path(releaseDirPath()), version(), selected)
    }

    /**
     * Pre-publish check phase: read the release directory back into a [[ReleaseSnapshot]] and run every
     * [[DesktopReleaseChecks]] check against it, logging each check's name and outcome.
     *
     * `--require-signature` defaults to `true` — the workflow's real use, run after the signing step and
     * before either upload. `ci.desktop.all` passes `false`: it runs canonicalize immediately followed by
     * verify with no signing step in between, so `checksums.txt.asc` does not exist yet there.
     *
     * `platforms` mirrors [[canonicalize]]'s option: a comma-separated token list, defaulting to all five,
     * so CI verifying a pull request's packaging checks exactly the subset it packaged.
     *
     * Throws with every collected problem (across every failing check) when any check fails, so a reader
     * sees the whole picture rather than the first line.
     */
    def verify(requireSignature: Boolean = true, platforms: String = DesktopPlatform.AllTokens) =
      Task.Command(exclusive = true) {
        val selected = parsePlatforms(platforms)
        runVerify(os.Path(releaseDirPath()), version(), requireSignature, selected)
      }

    private def parsePlatforms(platforms: String)(using TaskCtx): Seq[DesktopPlatform] =
      DesktopPlatform
        .parseTokens(platforms)
        .fold(message => throw new Exception(s"ci.desktop: $message"), identity)

    // Command bodies live in private helpers so `all` can sequence them. A Task.Command cannot be
    // invoked from another command body — the same reason `sonatype.all` calls `runArtifactPhase`
    // and `runUploadPhase` rather than its sibling commands.
    private def runCanonicalize(
        staging: os.Path,
        release: os.Path,
        version: String,
        platforms: Seq[DesktopPlatform]
    )(using TaskCtx): Unit = {
      val manifest = DesktopRelease
        .canonicalize(staging, release, version, platforms)
        .fold(message => throw new Exception(s"ci.desktop.canonicalize failed: $message"), identity)
      manifest.entries.foreach(entry => Task.log.info(s"ci.desktop: ${entry.name} ${entry.sha256}"))
      Task.log.info(s"ci.desktop: ${manifest.entries.size} assets in $release")
    }

    private def runVerify(
        release: os.Path,
        version: String,
        requireSignature: Boolean,
        platforms: Seq[DesktopPlatform]
    )(using TaskCtx): Unit = {
      val snapshot = ReleaseSnapshot.read(release, version, platforms)
      val checks   = DesktopReleaseChecks.defaults(requireSignature)
      val outcomes = ReleaseVerifier.run(checks, snapshot)
      outcomes.foreach { outcome =>
        if (outcome.passed) Task.log.info(s"ci.desktop.verify: ${outcome.name} PASSED")
        else outcome.problems.foreach(problem => Task.log.error(s"ci.desktop.verify: ${outcome.name} FAILED: $problem"))
      }
      val problems = outcomes.flatMap(_.problems)
      if (problems.nonEmpty)
        throw new Exception(
          s"ci.desktop.verify: ${problems.size} problem(s) found in $release:\n" + problems.map(p => s"  - $p").mkString("\n")
        )
      Task.log.info(s"ci.desktop.verify: ${outcomes.size} checks passed (requireSignature=$requireSignature)")
    }

    /**
     * Upload every canonicalized asset to the release for `tag`.
     *
     * If no release exists for the tag, one is created as a **draft**. Publishing a release is a human
     * action, and the workflow only reaches this task on `release: published` — it has no `push: tags:`
     * trigger, so a bare tag push never runs it.
     */
    def githubRelease(tag: String) = Task.Command(exclusive = true) {
      runGithubRelease(os.Path(releaseDirPath()), tag)
    }

    private def runGithubRelease(release: os.Path, tag: String)(using TaskCtx): Unit = {
      require(tag.nonEmpty, "ci.desktop.githubRelease: --tag is required")
      val assets  = os.list(release).filter(os.isFile).sortBy(_.last)
      if (assets.isEmpty) throw new Exception(s"ci.desktop.githubRelease: no assets in $release")

      val checksums = release / DesktopReleaseLayout.ChecksumsFileName
      if (!os.exists(checksums))
        throw new Exception(s"ci.desktop.githubRelease: missing $checksums — run canonicalize first")

      if (dryRun) {
        Task.log.info(s"DRY_RUN: would upload ${assets.size} assets to release $tag")
      } else {
        val exists = os.proc("gh", "release", "view", tag)
          .call(cwd = BuildCtx.workspaceRoot, check = false)
          .exitCode == 0
        if (!exists) {
          Task.log.info(s"ci.desktop: no release for $tag — creating a draft")
          os.proc("gh", "release", "create", tag, "--draft", "--title", tag, "--generate-notes")
            .call(cwd = BuildCtx.workspaceRoot)
        }
        os.proc("gh", "release", "upload", tag, assets.map(_.toString), "--clobber")
          .call(cwd = BuildCtx.workspaceRoot)
        Task.log.info(s"ci.desktop: uploaded ${assets.size} assets to $tag")
      }
    }

    /** Upload the five desktop archives to Sonatype Central in one deployment. */
    def sonatype(evaluator: Evaluator) = Task.Command(exclusive = true) {
      runSonatype(evaluator, version())
    }

    /**
     * Upload the five desktop archives to Sonatype Central as a single deployment.
     *
     * The per-module `publishSonatypeCentral` (used by libraries and plugins) hardcodes
     * `bundleName = None`, so five archives means five separate Central deployments. Each one
     * defaults to `PublishingType.AUTOMATIC`, so it is released — made public — irrevocably the
     * moment it succeeds. If, say, the third of five failed, the first two would already be public,
     * and a retry would fail outright: Central rejects re-uploading a version that already exists.
     *
     * `publishAll` accepts a `bundleName` and folds every artifact into one deployment, so nothing is
     * released until all five upload and validate together — a failed run publishes nothing, and the
     * step is safely retriable.
     *
     * The `platform[_]` cross wildcard selects exactly the five `DesktopPlatform` modules under
     * `morphir.desktop.dist` — nothing else in the build is swept in.
     *
     * The bundle name embeds `desktopVersion` (the same `version()`, the dist modules publish under).
     * That value is always a released, non-SNAPSHOT version here: this task only runs from the
     * `desktop-release` workflow job (tags and published releases), which never sets
     * `MORPHIR_PUBLISH_MODE=snapshot`. That matters because `publishAll` refuses a `bundleName`
     * outright when any selected artifact resolves to a SNAPSHOT version.
     */
    private def runSonatype(evaluator: Evaluator, desktopVersion: String)(using TaskCtx): Unit = {
      val artifactsSelector = "morphir.desktop.dist.platform[_].publishArtifacts"
      val bundleName        = s"morphir-desktop-$desktopVersion"
      val tokens = Seq(
        "mill.javalib.SonatypeCentralPublishModule/publishAll",
        "--publishArtifacts",
        artifactsSelector,
        "--bundleName",
        bundleName
      )
      Task.log.info(s"ci.desktop: uploading desktop archives to Sonatype as bundle '$bundleName'")
      if (dryRun) Task.log.info(s"DRY_RUN: would evaluate ${tokens.mkString(" ")}")
      else {
        ensureMillPublishEnv()
        evaluateAll(
          evaluator,
          tokens,
          s"publishAll (desktop bundle $bundleName)",
          selectMode = SelectMode.Separated
        )
      }
    }

    /**
     * Canonicalize, verify, then both destinations.
     *
     * Verifies with `requireSignature = false`: this command runs canonicalize immediately followed by
     * verify, with no signing step in between (signing is a workflow step, not something `canonicalize`
     * does), so `checksums.txt.asc` does not exist yet at this point in a local `ci.desktop.all` run. The
     * workflow itself runs `ci.desktop.verify` separately — with the default `requireSignature = true` —
     * after its own signing step and before either upload.
     */
    def all(evaluator: Evaluator, tag: String) = Task.Command(exclusive = true) {
      val release = os.Path(releaseDirPath())
      val desktopVersion = version()
      val allPlatforms = DesktopPlatform.values.toSeq
      runCanonicalize(os.Path(stagingRootPath()), release, desktopVersion, allPlatforms)
      runVerify(release, desktopVersion, requireSignature = false, allPlatforms)
      runGithubRelease(release, tag)
      runSonatype(evaluator, desktopVersion)
    }
  }

  /**
   * Scalafmt check over resolved `morphir.__.sources` tasks, including modules that do not mix in
   * `ScalafmtModule`.
   *
   * `--exclude` is a regex matched against each module path. A match drops that module from the
   * check set. A blank exclude keeps every resolved module and runs one `checkFormatAll`.
   */
  def lint(evaluator: Evaluator, exclude: String = "") = Task.Command(exclusive = true) {
    val resolved = unwrap(
      evaluator.resolveSegments(Seq(LintSelectors.sourcesSelector), SelectMode.Multi),
      s"resolve ${LintSelectors.sourcesSelector}"
    ).map(_.render)
    val modules = LintSelectors.modulesFromResolved(resolved)
    val kept = LintSelectors.excludeMatching(modules, exclude) match {
      case Right(selected) => selected
      case Left(message)   => throw new Exception(message)
    }
    if kept.isEmpty then
      throw new Exception(
        s"ci.lint: no ${LintSelectors.sourcesSuffix} targets remain" +
          (if exclude.isBlank then "" else s" after --exclude $exclude")
      )
    val sourceSelectors =
      if kept.size == modules.size then Seq(LintSelectors.sourcesSelector)
      else kept.map(module => s"$module${LintSelectors.sourcesSuffix}")
    Task.log.info(s"ci.lint: checking ${kept.size} source modules")
    sourceSelectors.foreach(selector => evaluateLint(evaluator, selector))
  }

  private def evaluateLint(evaluator: Evaluator, sourcesSelector: String): Unit = {
    val evalResult = unwrap(
      evaluator.evaluate(
        Seq("mill.scalalib.scalafmt.ScalafmtModule/checkFormatAll", sourcesSelector),
        SelectMode.Separated
      ),
      s"ci.lint $sourcesSelector"
    )
    evalResult.values.toEither match {
      case Left(msg) => throw new Exception(s"ci.lint $sourcesSelector failed: $msg")
      case Right(_)  => ()
    }
  }

  /**
   * The "Run JS tests" phase of the `test-js` / `test-js-desktop` CI jobs — compile, publish, and
   * both JS and Wasm test runs — scoped to `group` (`"platform"` or `"desktop"`).
   *
   * `morphir.ui`, `morphir.desktop` and `morphir.appkit.electron` link a big enough working set that
   * running them alongside the rest of the JS tree OOM'd the Scala.js linker inside its source-map
   * printer (morphir-oyn). Splitting the load across two CI jobs — two runners, two daemons — needs
   * two disjoint, exhaustive subsets of the same wildcard, which a Mill selector cannot express by
   * itself, so this resolves the full wildcard and hands it to [[JsTestSelectors]] to partition. See
   * that object for why the split is exhaustive and disjoint by construction, and why an empty
   * bucket is a hard failure rather than a silently-passing no-op.
   */
  def testJs(evaluator: Evaluator, group: String) = Task.Command(exclusive = true) {
    runJsGroup(evaluator, JsTestSelectors.mainPhaseSelectors, group, "ci.testJs")
  }

  /**
   * The "Link the WebAssembly variants" phase of [[testJs]] — kept a separate command so CI can run
   * it at `-j 1` while the rest of the phase runs at higher concurrency; see
   * `.config/mise/tasks/test/js` for why Wasm links are serialized.
   */
  def testJsWasmLink(evaluator: Evaluator, group: String) = Task.Command(exclusive = true) {
    runJsGroup(evaluator, Seq(JsTestSelectors.wasmLinkSelector), group, "ci.testJsWasmLink")
  }

  private def runJsGroup(
      evaluator: Evaluator,
      selectors: Seq[String],
      group: String,
      what: String
  )(using TaskCtx): Unit = {
    val resolved = selectors.flatMap { selector =>
      unwrap(evaluator.resolveSegments(Seq(selector), SelectMode.Multi), s"resolve $selector").map(_.render)
    }
    val kept = JsTestSelectors.selectGroup(resolved, group, what) match {
      case Right(selected) => selected
      case Left(message)   => throw new Exception(message)
    }
    Task.log.info(s"$what: evaluating ${kept.size} targets (group=$group)")
    evaluateAll(evaluator, kept, s"$what (group=$group)")
  }

  /**
   * Cross-destination aggregator. CI calls `ci.publish`. Today that is Sonatype only; the desktop
   * destination is `ci.desktop`, invoked by its own release job.
   */
  def publish(evaluator: Evaluator) = Task.Command(exclusive = true) {
    Task.log.info("ci.publish: running destination fan-out (sonatype)")
    val cfg = publishFilterConfig()
    runArtifactPhase(evaluator, PublishKind.All, cfg)
    runUploadPhase(evaluator, PublishKind.All, cfg)
  }

  def publishFilterConfig = Task {
    PublishFilterConfig(
      libraryModulePrefix = libraryModulePrefix(),
      libraryExcludedPrefixes = libraryExcludedPrefixes(),
      excludedModuleSubstrings = excludedModuleSubstrings(),
      uploadJobs = uploadJobs()
    )
  }

  private def runArtifactPhase(
      evaluator: Evaluator,
      kind: PublishKind,
      cfg: PublishFilterConfig
  )(using TaskCtx): Unit = {
    val selectors = resolvePublishModules(evaluator, kind, cfg).map(m => s"$m.publishArtifacts")
    Task.log.info(s"ci.sonatype: building ${selectors.size} publishArtifacts ($kind)")
    if dryRun then Task.log.info(s"DRY_RUN: would evaluate ${selectors.mkString(" + ")}")
    else evaluateAll(evaluator, selectors, s"publishArtifacts ($kind)")
  }

  private def runUploadPhase(
      evaluator: Evaluator,
      kind: PublishKind,
      cfg: PublishFilterConfig
  )(using TaskCtx): Unit = {
    val selectors =
      resolvePublishModules(evaluator, kind, cfg).map(m => s"$m.publishSonatypeCentral")
    val jobs = cfg.uploadJobs.max(1)
    Task.log.info(
      s"ci.sonatype: uploading ${selectors.size} publishSonatypeCentral ($kind, serial=${jobs == 1})"
    )
    if dryRun then Task.log.info(s"DRY_RUN: would evaluate ${selectors.mkString(" + ")}")
    else {
      ensureMillPublishEnv()
      if jobs == 1 then
        selectors.foreach { selector =>
          evaluateAll(evaluator, Seq(selector), s"publishSonatypeCentral $selector")
        }
      else evaluateAll(evaluator, selectors, s"publishSonatypeCentral ($kind)")
    }
  }

  private def dryRun(using TaskCtx): Boolean =
    Task.env.get("DRY_RUN").orElse(sys.env.get("DRY_RUN")).exists(v =>
      v.equalsIgnoreCase("true") || v == "1"
    )

  private def resolvePublishModules(
      evaluator: Evaluator,
      kind: PublishKind,
      cfg: PublishFilterConfig
  ): Seq[String] = {
    val filtered = kind match {
      case PublishKind.Plugins =>
        pluginPublishModules(evaluator)
      case PublishKind.Libraries =>
        PublishSelectors.libraryModules(
          allPublishModules(evaluator, cfg),
          cfg.libraryModulePrefix,
          cfg.libraryExcludedPrefixes,
          pluginModuleRoots
        )
      case PublishKind.All =>
        PublishSelectors.allKinds(
          allPublishModules(evaluator, cfg),
          pluginPublishModules(evaluator)
        )
    }

    if filtered.isEmpty then
      throw new Exception(s"Mill resolved no publishSonatypeCentral modules for kind $kind")
    filtered
  }

  private def pluginModuleRoots: Seq[String] =
    pluginModules.map(_.apply().moduleSegments.render)

  private def pluginPublishModules(evaluator: Evaluator): Seq[String] =
    pluginModules
      .flatMap { ref =>
        val root = ref().moduleSegments.render
        unwrap(
          evaluator.resolveSegments(Seq(s"$root.__.publishSonatypeCentral"), SelectMode.Multi),
          s"resolve $root.__.publishSonatypeCentral"
        ).map(_.render)
      }
      .filter(_.endsWith(".publishSonatypeCentral"))
      .map { rendered =>
        if rendered.contains(' ') then
          throw new Exception(s"resolve plugin publish modules: unexpected space in $rendered")
        rendered.stripSuffix(".publishSonatypeCentral")
      }
      .distinct
      .sorted

  private def allPublishModules(evaluator: Evaluator, cfg: PublishFilterConfig): Seq[String] =
    PublishSelectors.dropExcluded(
      unwrap(
        evaluator.resolveSegments(Seq("__.publishSonatypeCentral"), SelectMode.Multi),
        "resolve __.publishSonatypeCentral"
      )
        .map(_.render)
        .filter(_.endsWith(".publishSonatypeCentral"))
        .map { rendered =>
          if rendered.contains(' ') then
            throw new Exception(s"resolve __.publishSonatypeCentral: unexpected space in $rendered")
          rendered.stripSuffix(".publishSonatypeCentral")
        },
      cfg.excludedModuleSubstrings
    )

  private def evaluateAll(
      evaluator: Evaluator,
      selectors: Seq[String],
      what: String,
      selectMode: SelectMode = SelectMode.Multi
  ): Unit = {
    if selectors.isEmpty then throw new Exception(s"$what: no selectors")
    val evalResult = unwrap(evaluator.evaluate(selectors, selectMode), what)
    evalResult.values.toEither match {
      case Left(msg) => throw new Exception(s"$what failed: $msg")
      case Right(_)  => ()
    }
  }

  private def unwrap[T](result: Result[T], what: String): T =
    result.toEither match {
      case Right(value) => value
      case Left(msg)    => throw new Exception(s"$what failed: $msg")
    }

  /**
   * Mill Morphir plugins compile against `com.lihaoyi::mill-libs-scalalib`, which is on Maven Central
   * for Mill 1.x — the older mill-scalalib Central exclusion is retired; plugins are in the publish set.
   *
   * `publishSonatypeCentral` reads `MILL_PGP_*` from `Task.env` (process env at Mill start).
   * `ci.sonatype.writeMillEnv` converts Morphir CI `GPG_*` names; GHA sources that file first.
   */
  private def ensureMillPublishEnv()(using TaskCtx): Unit = {
    val env = Task.env
    def present(name: String): Boolean = env.get(name).exists(v => !v.isBlank)

    val missing = Seq.newBuilder[String]
    if !present("MILL_PGP_SECRET_BASE64") then missing += "MILL_PGP_SECRET_BASE64"
    if !present("MILL_PGP_PASSPHRASE") then missing += "MILL_PGP_PASSPHRASE"
    if !(present("MILL_SONATYPE_USERNAME") || present("SONATYPE_USERNAME")) then
      missing += "MILL_SONATYPE_USERNAME|SONATYPE_USERNAME"
    if !(present("MILL_SONATYPE_PASSWORD") || present("SONATYPE_PASSWORD")) then
      missing += "MILL_SONATYPE_PASSWORD|SONATYPE_PASSWORD"

    val absent = missing.result()
    if absent.nonEmpty then
      throw new Exception(
        s"Missing Mill publish env (${absent.mkString(", ")}). " +
          "Run ci.sonatype.writeMillEnv and source the file before ./mill -i ci.publish " +
          "(see the Release step in .github/workflows/ci.yml; helpers in org.finos.morphir.mill.publish)."
      )

    PgpSecret.validate(env("MILL_PGP_SECRET_BASE64"), msg => Task.log.info(msg))
  }
}
