package build.ci

import build.MorphirVersionedModule
import build.{`mill-plugins` => millPlugins}
import build.{morphir => morphirArea}
import mill.*
import mill.api.{BuildCtx, DefaultTaskModule, Evaluator, ModuleRef, Result, SelectMode, TaskCtx}
import millbuild.{CliRelease, JsTestSelectors, LintSelectors, MepNativeImageSmoke, MillVersions, NativeTestSelectors}
import org.finos.morphir.mill.publish.{MillPublishEnvFile, MillSonatypeEnv, PgpSecret, PublishSelectors}

/** One independently versioned area, as [[MorphirCiModule.releaseAreas]] reports it. */
case class ReleaseAreaRow(
    name: String,
    namespace: Option[String],
    changelogPath: String,
    startingVersion: Option[String]
)

object ReleaseAreaRow {
  implicit val readWriter: upickle.default.ReadWriter[ReleaseAreaRow] = upickle.default.macroRW
}

/**
 * CI commands that YAML cannot express. Morphir inventory knobs for libraries live in `ci/package.mill.yaml`;
 * publishable Mill plugins are [[pluginModules]] ModuleRefs.
 *
 * The Morphir desktop application and its own `ci.desktop` release destination retired with the Electron UI (the
 * desktop/web UI now lives at finos/morphir-ui); [[sonatype]] plus [[lint]] remain this module's release-side slice.
 *
 * Dynamic task selection uses Mill's exclusive [[Evaluator]] commands (same mechanism as builtin `resolve` / `show`).
 * Nested `./mill` is intentionally avoided — under `mill -i` it deadlocks on the workspace write lock.
 *
 * Upload expects `MILL_PGP_*` / `MILL_SONATYPE_*` (or `SONATYPE_*`) already in the Mill process environment. The
 * Release workflow runs `ci.sonatype.writeMillEnv` (GPG_* in that mill's `Task.env`), sources the file, then starts
 * `./mill -i ci.publish` so `Task.env` sees `MILL_*`. Conversion lives in mill-morphir-core
 * (`org.finos.morphir.mill.publish`).
 */
trait MorphirCiModule extends Module, LinkerBenchmarkModule {

  /** Module-path prefix for library Sonatype publishables. Set in `package.mill.yaml`. */
  def libraryModulePrefix = Task { "" }

  /** Prefixes never treated as libraries even when [[libraryModulePrefix]] would match. */
  def libraryExcludedPrefixes = Task { Seq.empty[String] }

  /** Drop any module whose Mill path contains one of these substrings. */
  def excludedModuleSubstrings = Task { Seq.empty[String] }

  /**
   * Parallelism for `publishSonatypeCentral`. `1` means serial `evaluator.evaluate` calls (SLF4J / #957). Values
   * greater than 1 evaluate the batch under the outer `--jobs` setting.
   */
  def uploadJobs = Task { 1 }

  /**
   * The independently versioned areas as the build sees them, read from the modules that declare them rather than
   * restated here.
   *
   * `squire changelog check` keeps its own copy of this table, in `SquireChangelog.Areas`, because a Mill script cannot
   * depend on the build. `.config/version-rules/corpus.json` is where the two are pinned together, and this task is
   * what lets a test read the build's side of it without parsing `package.mill`. Raising a floor here and forgetting
   * the port would otherwise leave the CI policy gate validating the old one.
   *
   * Useful on its own: `./mill show ci.releaseAreas` answers "what does the build think it releases, and from which
   * changelog" without reading three files.
   */
  def releaseAreas: T[Seq[ReleaseAreaRow]] = Task {
    Seq(
      releaseAreaRow("libraries", morphirArea.jvm)(),
      releaseAreaRow("mill-plugins", millPlugins.morphir.core(MillVersions.oldest))()
    )
  }

  /**
   * Reads one module's area declaration. The changelog is reported workspace-relative, since an absolute path names
   * this checkout rather than the repository.
   */
  private def releaseAreaRow(name: String, module: MorphirVersionedModule): Task[ReleaseAreaRow] = Task.Anon {
    ReleaseAreaRow(
      name = name,
      namespace = module.versionNamespace(),
      changelogPath = module.changelog().path.relativeTo(BuildCtx.workspaceRoot).toString,
      startingVersion = module.startingVersion()
    )
  }

  /**
   * Publishable mill-morphir plugin Cross roots. `integration` is omitted (test-only). ModuleRefs keep the inventory
   * type-safe; expand via Evaluator under each root.
   */
  def pluginModules: Seq[ModuleRef[Module]] = Seq(
    ModuleRef(millPlugins.morphir.toolchain),
    ModuleRef(millPlugins.morphir.javascript),
    ModuleRef(millPlugins.morphir.`elm-tooling`),
    ModuleRef(millPlugins.morphir.core),
    ModuleRef(millPlugins.morphir.elm)
  )

  final case class PublishFilterConfig(
      libraryModulePrefix: String,
      libraryExcludedPrefixes: Seq[String],
      excludedModuleSubstrings: Seq[String],
      uploadJobs: Int
  ) derives upickle.default.ReadWriter

  enum PublishKind {
    case Libraries, Plugins, All
  }

  object sonatype extends Module, DefaultTaskModule {
    def defaultTask(): String = "all"

    def artifactsLibraries(evaluator: Evaluator) = Task.Command(exclusive = true) {
      runArtifactPhase(evaluator, PublishKind.Libraries, publishFilterConfig())
    }

    def artifactsPlugins(evaluator: Evaluator) = Task.Command(exclusive = true) {
      runArtifactPhase(evaluator, PublishKind.Plugins, publishFilterConfig())
    }

    def artifacts(evaluator: Evaluator) = Task.Command(exclusive = true) {
      runArtifactPhase(evaluator, PublishKind.All, publishFilterConfig())
    }

    def libraries(evaluator: Evaluator) = Task.Command(exclusive = true) {
      runUploadPhase(evaluator, PublishKind.Libraries, publishFilterConfig())
    }

    def plugins(evaluator: Evaluator) = Task.Command(exclusive = true) {
      runUploadPhase(evaluator, PublishKind.Plugins, publishFilterConfig())
    }

    /**
     * Write `MILL_*` publish env for a later mill process. Values are not logged.
     *
     * GHA: `./mill -i ci.sonatype.writeMillEnv --path "$envfile"` then `source` the file before `./mill -i ci.publish`.
     * `Task.env` is snapshotted at mill start, so conversion inside the publish mill cannot feed
     * `publishSonatypeCentral`.
     */
    def writeMillEnv(path: os.Path) = Task.Command {
      val dest    = MillPublishEnvFile.requireWritableDest(path, BuildCtx.workspaceRoot)
      val millEnv = MillSonatypeEnv.fromEnvOrThrow(
        sys.env ++ Task.env,
        msg => Task.log.info(msg)
      )
      PgpSecret.validate(millEnv.pgpSecretBase64, msg => Task.log.info(msg))
      os.write.over(dest, millEnv.toDotenv, createFolders = true, perms = "rw-------")
      Task.log.info(s"Wrote Mill publish env to $dest (values not logged)")
    }

    /** Full Sonatype destination: artifacts then upload. */
    def all(evaluator: Evaluator) = Task.Command(exclusive = true) {
      val cfg = publishFilterConfig()
      runArtifactPhase(evaluator, PublishKind.All, cfg)
      runUploadPhase(evaluator, PublishKind.All, cfg)
    }
  }

  /** GitHub Release packaging for the morphir-scala command-line application. */
  object cli extends Module {
    def releaseDirPath = Task.Input {
      Task.env
        .get("MORPHIR_CLI_RELEASE_DIR")
        .map(value => os.Path(value, BuildCtx.workspaceRoot))
        .getOrElse(BuildCtx.workspaceRoot / ".dev" / "dist" / "cli" / "release")
        .toString
    }

    def transportDirPath = Task.Input {
      Task.env
        .get("MORPHIR_CLI_TRANSPORT_DIR")
        .map(value => os.Path(value, BuildCtx.workspaceRoot))
        .getOrElse(BuildCtx.workspaceRoot / ".dev" / "dist" / "cli" / "transport")
        .toString
    }

    def version = Task { morphirArea.main.publishVersion() }

    def writeMepVersionEnv(path: String) = Task.Command(exclusive = true) {
      require(path.nonEmpty, "ci.cli.writeMepVersionEnv: --path is required")
      val releaseVersion = version()
      val destination    = os.Path(path, BuildCtx.workspaceRoot)
      os.write.append(
        destination,
        s"MORPHIR_ELM_MEP_VERSION=$releaseVersion\n",
        createFolders = true
      )
      Task.log.info(s"ci.cli: exported Elm MEP provider version to $destination")
    }

    def packageNative(platform: String) = Task.Command(exclusive = true) {
      val selected = nativeHost(platform, "packageNative")

      val releaseVersion = version()
      val executable     = morphirArea.main.nativeImage().path
      verifyExecutable(executable, Seq.empty, releaseVersion)
      val asset = CliRelease.packageNative(
        selected,
        releaseVersion,
        executable,
        os.Path(releaseDirPath())
      )
      Task.log.info(s"ci.cli: packaged ${asset.last}")
    }

    def packageMepNative(platform: String) = Task.Command(exclusive = true) {
      val selected           = nativeHost(platform, "packageMepNative")
      val releaseVersion     = version()
      val mepProviderVersion = morphirArea.langkit.elm.compiler.mep.jvm.mepProviderVersion()
      if mepProviderVersion != releaseVersion then
        throw new Exception(
          s"ci.cli.packageNative: Elm MEP provider version '$mepProviderVersion' does not match release version '$releaseVersion'"
        )
      morphirArea.langkit.elm.compiler.mep.jvm.nativeImageSmoke()
      val mepAsset = CliRelease.packageMepNative(
        selected,
        releaseVersion,
        morphirArea.langkit.elm.compiler.mep.jvm.nativeImage().path,
        os.Path(releaseDirPath())
      )
      MepNativeImageSmoke.verify(mepAsset, releaseVersion)
      Task.log.info(s"ci.cli: packaged ${mepAsset.last}")
    }

    def packageNativeTransport(platform: String) = Task.Command(exclusive = true) {
      val selected       = nativeHost(platform, "packageNativeTransport")
      val releaseVersion = version()
      val transport = CliRelease.packageNativeTransport(
        selected,
        releaseVersion,
        os.Path(releaseDirPath()),
        os.Path(transportDirPath())
      )
      Task.log.info(s"ci.cli: archived ${transport.last}")
    }

    def extractNativeTransports(platforms: String = CliRelease.Platform.AllTokens) = Task.Command(exclusive = true) {
      val selected       = parsePlatforms(platforms)
      val releaseVersion = version()
      val problems = selected.flatMap { platform =>
        val transport = os.Path(transportDirPath()) / CliRelease.nativeTransportName(platform, releaseVersion)
        CliRelease
          .extractNativeTransport(platform, releaseVersion, transport, os.Path(releaseDirPath()))
          .fold(identity, _ => Seq.empty)
      }
      if problems.nonEmpty then
        throw new Exception(
          s"ci.cli.extractNativeTransports: ${problems.size} problem(s):\n" +
            problems.map(problem => s"  - $problem").mkString("\n")
        )
      Task.log.info(s"ci.cli: extracted ${selected.size} native package transports")
    }

    def packageJvm() = Task.Command(exclusive = true) {
      val releaseVersion = version()
      val assembly       = morphirArea.main.assembly().path
      verifyExecutable(assembly, Seq("java", "-jar"), releaseVersion)
      val asset = CliRelease.packageJvm(
        releaseVersion,
        assembly,
        os.Path(releaseDirPath())
      )
      Task.log.info(s"ci.cli: packaged ${asset.last}")
    }

    def verify(platforms: String = CliRelease.Platform.AllTokens, includeJvm: Boolean = true) =
      Task.Command(exclusive = true) {
        val selected = parsePlatforms(platforms)
        CliRelease
          .verifyAndWriteChecksums(
            os.Path(releaseDirPath()),
            version(),
            selected,
            includeJvm,
            requireExecutable = true
          )
          .fold(
            problems =>
              throw new Exception(
                s"ci.cli.verify: ${problems.size} problem(s):\n${problems.map(p => s"  - $p").mkString("\n")}"
              ),
            assets => Task.log.info(s"ci.cli: verified ${assets.size} release assets")
          )
      }

    /**
     * Stage every verified CLI asset on the GitHub release for `tag`, creating the release as a **draft** when none
     * exists yet.
     *
     * The workflow runs this from a v* tag push (or a manual dispatch on that tag). The tag push stages; a human
     * publishes the draft, and that publication is what fires the release-publish workflow that promotes the release to
     * Maven Central. `--verify-tag` refuses to conjure a tag that was never pushed. Uploads pass `--clobber`, so a
     * failed run is safely retriable by dispatching the workflow on the same tag.
     */
    def githubRelease(tag: String) = Task.Command(exclusive = true) {
      require(tag.nonEmpty, "ci.cli.githubRelease: --tag is required")
      val release = os.Path(releaseDirPath())
      val assets  = os.list(release).filter(os.isFile).sortBy(_.last)
      if assets.isEmpty then throw new Exception(s"ci.cli.githubRelease: no assets in $release")
      if !os.isFile(release / "checksums.txt") then
        throw new Exception(s"ci.cli.githubRelease: missing checksums.txt; run ci.cli.verify first")

      if dryRun then Task.log.info(s"DRY_RUN: would upload ${assets.size} CLI assets to release $tag")
      else
        val exists = os.proc("gh", "release", "view", tag)
          .call(cwd = BuildCtx.workspaceRoot, check = false)
          .exitCode == 0
        if !exists then
          Task.log.info(s"ci.cli: no release for $tag — creating a draft")
          os.proc("gh", "release", "create", tag, "--draft", "--verify-tag", "--title", tag, "--generate-notes")
            .call(cwd = BuildCtx.workspaceRoot)
        os.proc("gh", "release", "upload", tag, assets.map(physicalPath), "--clobber")
          .call(cwd = BuildCtx.workspaceRoot)
        Task.log.info(s"ci.cli: uploaded ${assets.size} assets to $tag")
    }

    /**
     * Prove the staged release, not the local staging directory: download every CLI asset fresh from the GitHub release
     * for `tag` and run the same verifier over the download, then require the release's `checksums.txt` to match the
     * one recomputed from the downloaded bytes. A truncated, corrupted or mislabeled upload fails here instead of a
     * user's install. Runs against drafts and published releases alike — `gh` resolves both by tag — so phase one
     * (staging) and phase two (promotion) each get the same proof.
     */
    def verifyRelease(tag: String, platforms: String = CliRelease.Platform.AllTokens, includeJvm: Boolean = true) =
      Task.Command(exclusive = true) {
        require(tag.nonEmpty, "ci.cli.verifyRelease: --tag is required")
        if dryRun then Task.log.info(s"DRY_RUN: would download and verify CLI assets on release $tag")
        else
          val downloaded = Task.dest / "assets"
          os.makeDir.all(downloaded)
          os.proc(
            "gh",
            "release",
            "download",
            tag,
            "--dir",
            physicalPath(downloaded),
            "--pattern",
            "morphir-cli-*",
            "--pattern",
            "morphir-scala-elm-*",
            "--pattern",
            "checksums.txt"
          ).call(cwd = BuildCtx.workspaceRoot)
          val checksums = downloaded / "checksums.txt"
          if !os.isFile(checksums) then
            throw new Exception(s"ci.cli.verifyRelease: release $tag carries no checksums.txt")
          val published = os.read(checksums)
          CliRelease
            .verifyAndWriteChecksums(downloaded, version(), parsePlatforms(platforms), includeJvm)
            .fold(
              problems =>
                throw new Exception(
                  s"ci.cli.verifyRelease: ${problems.size} problem(s) on release $tag:\n" +
                    problems.map(p => s"  - $p").mkString("\n")
                ),
              assets => Task.log.info(s"ci.cli: verified ${assets.size} published assets on $tag")
            )
          val recomputed = os.read(checksums)
          if published != recomputed then
            throw new Exception(
              s"ci.cli.verifyRelease: checksums.txt on release $tag does not match the downloaded assets"
            )
      }

    private def parsePlatforms(platforms: String): Seq[CliRelease.Platform] =
      val tokens = platforms.split(",", -1).toSeq.map(_.trim)
      if tokens.isEmpty || tokens.exists(_.isEmpty) then
        throw new Exception(s"ci.cli: platform list contains an empty token: '$platforms'")
      tokens.map { token =>
        CliRelease.Platform
          .fromToken(token)
          .fold(message => throw new Exception(s"ci.cli: $message"), identity)
      }

    private def nativeHost(platform: String, operation: String): CliRelease.Platform = {
      val selected = CliRelease.Platform
        .fromToken(platform)
        .fold(message => throw new Exception(s"ci.cli.$operation: $message"), identity)
      val host = CliRelease.Platform
        .fromHost(System.getProperty("os.name"), System.getProperty("os.arch"))
        .fold(message => throw new Exception(s"ci.cli.$operation: $message"), identity)
      if selected != host then
        throw new Exception(
          s"ci.cli.$operation: requested ${selected.token}, but GraalVM is running for ${host.token}"
        )
      selected
    }

    private def verifyExecutable(executable: os.Path, prefix: Seq[String], expectedVersion: String)(using
        TaskCtx
    ): Unit = {
      val command         = prefix :+ physicalPath(executable)
      val versionResult   = os.proc(command, "version").call(cwd = BuildCtx.workspaceRoot)
      val reportedVersion = CliRelease.lastNonBlankLine(versionResult.out.text())
      if (!reportedVersion.contains(expectedVersion))
        throw new Exception(
          s"ci.cli: packaged executable reports '${reportedVersion.getOrElse("<no output>")}', expected '$expectedVersion'"
        )
      val topLevelHelp = os.proc(command, "--help").call(cwd = BuildCtx.workspaceRoot).out.text()
      if (!topLevelHelp.linesIterator.map(stripAnsi).exists(_.trim == "server"))
        throw new Exception("ci.cli: packaged executable omits the server command")
      os.proc(command, "server", "--help").call(cwd = BuildCtx.workspaceRoot)
      Task.log.info(s"ci.cli: smoke-tested ${executable.last}")
    }

    private def stripAnsi(value: String): String =
      value.replaceAll("\\u001b\\[[;\\d]*m", "")
  }

  /**
   * Format check over resolved `morphir.__.sources` (scalafmt), build `.mill` files, and Morphir Elm sources.
   *
   * `--exclude` is a regex matched against each Scala module path only. A match drops that module from the scala check
   * set. Build `.mill` and Elm checks always run via one evaluate of the format module's build-and-Elm check command. A
   * blank exclude keeps every resolved module and runs one `checkFormatAll` for scala.
   */
  def lint(evaluator: Evaluator, exclude: String = "") = Task.Command(exclusive = true) {
    val resolved = unwrap(
      evaluator.resolveSegments(Seq(LintSelectors.sourcesSelector), SelectMode.Multi),
      s"resolve ${LintSelectors.sourcesSelector}"
    ).map(_.render)
    val modules = LintSelectors.modulesFromResolved(resolved)
    val kept    = LintSelectors.excludeMatching(modules, exclude) match {
      case Right(selected) => selected
      case Left(message)   => throw new Exception(message)
    }
    if kept.isEmpty then
      throw new Exception(
        s"ci.lint: no ${LintSelectors.sourcesSuffix} targets remain" +
          (if exclude.isBlank then "" else s" after --exclude $exclude")
      )
    val sourceSelectors =
      if kept.size == modules.size then Seq(LintSelectors.sourcesSelector)
      else kept.map(module => s"$module${LintSelectors.sourcesSuffix}")
    Task.log.info(s"ci.lint: checking ${kept.size} source modules")
    sourceSelectors.foreach(selector => evaluateLint(evaluator, selector))
    Task.log.info("ci.lint: checking build .mill files and Elm sources")
    evaluateBuildAndElm(evaluator)
  }

  private def evaluateLint(evaluator: Evaluator, sourcesSelector: String): Unit = {
    val evalResult = unwrap(
      evaluator.evaluate(
        Seq("mill.scalalib.scalafmt.ScalafmtModule/checkFormatAll", sourcesSelector),
        SelectMode.Separated
      ),
      s"ci.lint $sourcesSelector"
    )
    evalResult.values.toEither match {
      case Left(msg) => throw new Exception(s"ci.lint $sourcesSelector failed: $msg")
      case Right(_)  => ()
    }
  }

  private def evaluateBuildAndElm(evaluator: Evaluator): Unit = {
    val evalResult = unwrap(
      evaluator.evaluate(Seq("format.checkBuildAndElm"), SelectMode.Separated),
      "ci.lint build .mill and Elm check"
    )
    evalResult.values.toEither match {
      case Left(msg) => throw new Exception(s"ci.lint build .mill and Elm check failed: $msg")
      case Right(_)  => ()
    }
  }

  /** Runs the curated non-classic JVM platform inventory through the CI command surface. */
  def testJvm(evaluator: Evaluator) = Task.Command(exclusive = true) {
    Task.log.info("ci.testJvm: evaluating the non-classic JVM platform inventory")
    evaluateAll(
      evaluator,
      Seq("Alias/run", "testJVMPlatform"),
      "ci.testJvm",
      selectMode = SelectMode.Separated
    )
  }

  /** Compiles the Scala Native modules and builds their publish artifacts before process-sharded tests run. */
  def testNativePrepare(evaluator: Evaluator) = Task.Command(exclusive = true) {
    val resolved = resolveTargets(evaluator, NativeTestSelectors.prepareSelectors)
    Task.log.info(s"ci.testNativePrepare: evaluating ${resolved.size} targets")
    evaluateAll(evaluator, resolved, "ci.testNativePrepare")
  }

  /**
   * Runs one deterministic Scala Native test shard.
   *
   * The shard is deliberately only one command invocation. `.config/mise/tasks/test/native` starts each shard in a
   * fresh daemonless Mill JVM, which releases the in-process Scala Native linker worker and its retained heap between
   * shards. Evaluating all shards from this command would keep that worker alive and recreate the OOM this split
   * avoids.
   */
  def testNative(evaluator: Evaluator, shard: Int = 0, shards: Int = 1) = Task.Command(exclusive = true) {
    val resolved = resolveTargets(evaluator, Seq(NativeTestSelectors.testSelector))
    val selected = NativeTestSelectors.selectShard(resolved, shard, shards, "ci.testNative") match {
      case Right(targets) => targets
      case Left(message)  => throw new Exception(message)
    }
    Task.log.info(s"ci.testNative: evaluating ${selected.size} targets (shard=$shard, shards=$shards)")
    evaluateAll(evaluator, selected, s"ci.testNative (shard=$shard, shards=$shards)")
  }

  /**
   * The "Run JS tests" phase of the `test-js` / `test-js-desktop` CI jobs — compile, publish, and both JS and Wasm test
   * runs — scoped to `group` (`"platform"` or `"desktop"`).
   *
   * `morphir.ui` alone links a big enough working set that running it alongside the rest of the JS tree OOM'd the
   * Scala.js linker inside its source-map printer (morphir-oyn) — originally alongside `morphir.desktop` and
   * `morphir.appkit.electron`, which retired with the Electron UI and left `morphir.ui` as the sole member of the
   * `"desktop"` group. Splitting the load across two CI jobs — two runners, two daemons — needs two disjoint,
   * exhaustive subsets of the same wildcard, which a Mill selector cannot express by itself, so this resolves the full
   * wildcard and hands it to [[JsTestSelectors]] to partition. See that object for why the split is exhaustive and
   * disjoint by construction, and why an empty bucket is a hard failure rather than a silently-passing no-op.
   */
  def testJs(evaluator: Evaluator, group: String) = Task.Command(exclusive = true) {
    runJsGroup(evaluator, JsTestSelectors.mainPhaseSelectors, group, "ci.testJs")
  }

  /**
   * The "Link the WebAssembly variants" phase of [[testJs]] — kept a separate command so CI can run it at `-j 1` while
   * the rest of the phase runs at higher concurrency; see `.config/mise/tasks/test/js` for why Wasm links are
   * serialized.
   */
  def testJsWasmLink(evaluator: Evaluator, group: String) = Task.Command(exclusive = true) {
    runJsGroup(evaluator, Seq(JsTestSelectors.wasmLinkSelector), group, "ci.testJsWasmLink")
  }

  private def runJsGroup(
      evaluator: Evaluator,
      selectors: Seq[String],
      group: String,
      what: String
  )(using TaskCtx): Unit = {
    val resolved = resolveTargets(evaluator, selectors)
    val kept     = JsTestSelectors.selectGroup(resolved, group, what) match {
      case Right(selected) => selected
      case Left(message)   => throw new Exception(message)
    }
    Task.log.info(s"$what: evaluating ${kept.size} targets (group=$group)")
    evaluateAll(evaluator, kept, s"$what (group=$group)")
  }

  private def resolveTargets(evaluator: Evaluator, selectors: Seq[String]): Seq[String] =
    selectors.flatMap { selector =>
      unwrap(evaluator.resolveSegments(Seq(selector), SelectMode.Multi), s"resolve $selector").map(_.render)
    }

  /**
   * Cross-destination aggregator. CI calls `ci.publish`. Today that is Sonatype only — the desktop application's own
   * `ci.desktop` release destination retired with the Electron UI.
   */
  def publish(evaluator: Evaluator) = Task.Command(exclusive = true) {
    Task.log.info("ci.publish: running destination fan-out (sonatype)")
    val cfg = publishFilterConfig()
    runArtifactPhase(evaluator, PublishKind.All, cfg)
    runUploadPhase(evaluator, PublishKind.All, cfg)
  }

  def publishFilterConfig = Task {
    PublishFilterConfig(
      libraryModulePrefix = libraryModulePrefix(),
      libraryExcludedPrefixes = libraryExcludedPrefixes(),
      excludedModuleSubstrings = excludedModuleSubstrings(),
      uploadJobs = uploadJobs()
    )
  }

  private def runArtifactPhase(
      evaluator: Evaluator,
      kind: PublishKind,
      cfg: PublishFilterConfig
  )(using TaskCtx): Unit = {
    val selectors = resolvePublishModules(evaluator, kind, cfg).map(m => s"$m.publishArtifacts")
    Task.log.info(s"ci.sonatype: building ${selectors.size} publishArtifacts ($kind)")
    if dryRun then Task.log.info(s"DRY_RUN: would evaluate ${selectors.mkString(" + ")}")
    else evaluateAll(evaluator, selectors, s"publishArtifacts ($kind)")
  }

  private def runUploadPhase(
      evaluator: Evaluator,
      kind: PublishKind,
      cfg: PublishFilterConfig
  )(using TaskCtx): Unit = {
    val selectors =
      resolvePublishModules(evaluator, kind, cfg).map(m => s"$m.publishSonatypeCentral")
    val jobs = cfg.uploadJobs.max(1)
    Task.log.info(
      s"ci.sonatype: uploading ${selectors.size} publishSonatypeCentral ($kind, serial=${jobs == 1})"
    )
    if dryRun then Task.log.info(s"DRY_RUN: would evaluate ${selectors.mkString(" + ")}")
    else {
      ensureMillPublishEnv()
      if jobs == 1 then
        selectors.foreach { selector =>
          evaluateAll(evaluator, Seq(selector), s"publishSonatypeCentral $selector")
        }
      else evaluateAll(evaluator, selectors, s"publishSonatypeCentral ($kind)")
    }
  }

  private def dryRun(using TaskCtx): Boolean =
    Task.env.get("DRY_RUN").orElse(sys.env.get("DRY_RUN")).exists(v =>
      v.equalsIgnoreCase("true") || v == "1"
    )

  /**
   * A path a subprocess can resolve. Mill's sandbox hands tasks paths through the `mill-workspace` alias, which the JVM
   * follows but an external process such as `gh` cannot — the v0.5.0-M05 staging run failed exactly there, with
   * `gh release upload` reporting `no matches found` for an aliased asset path. Every path handed to a subprocess as an
   * argument must pass through here first.
   */
  private def physicalPath(path: os.Path): String = {
    val normalized     = path.toString.replace('\\', '/')
    val workspaceAlias = "mill-workspace/"
    val aliasIndex     = normalized.indexOf(workspaceAlias)
    val workspace      = BuildCtx.workspaceRoot.toNIO.toFile.getCanonicalPath
    if aliasIndex >= 0 then
      val relative = normalized.substring(aliasIndex + workspaceAlias.length)
      new java.io.File(workspace, relative).getCanonicalPath
    else path.toNIO.toFile.getCanonicalPath
  }

  private def resolvePublishModules(
      evaluator: Evaluator,
      kind: PublishKind,
      cfg: PublishFilterConfig
  ): Seq[String] = {
    val filtered = kind match {
      case PublishKind.Plugins =>
        pluginPublishModules(evaluator)
      case PublishKind.Libraries =>
        PublishSelectors.libraryModules(
          allPublishModules(evaluator, cfg),
          cfg.libraryModulePrefix,
          cfg.libraryExcludedPrefixes,
          pluginModuleRoots
        )
      case PublishKind.All =>
        PublishSelectors.allKinds(
          allPublishModules(evaluator, cfg),
          pluginPublishModules(evaluator)
        )
    }

    if filtered.isEmpty then
      throw new Exception(s"Mill resolved no publishSonatypeCentral modules for kind $kind")
    filtered
  }

  private def pluginModuleRoots: Seq[String] =
    pluginModules.map(_.apply().moduleSegments.render)

  private def pluginPublishModules(evaluator: Evaluator): Seq[String] =
    pluginModules
      .flatMap { ref =>
        val root = ref().moduleSegments.render
        unwrap(
          evaluator.resolveSegments(Seq(s"$root.__.publishSonatypeCentral"), SelectMode.Multi),
          s"resolve $root.__.publishSonatypeCentral"
        ).map(_.render)
      }
      .filter(_.endsWith(".publishSonatypeCentral"))
      .map { rendered =>
        if rendered.contains(' ') then
          throw new Exception(s"resolve plugin publish modules: unexpected space in $rendered")
        rendered.stripSuffix(".publishSonatypeCentral")
      }
      .distinct
      .sorted

  private def allPublishModules(evaluator: Evaluator, cfg: PublishFilterConfig): Seq[String] =
    PublishSelectors.dropExcluded(
      unwrap(
        evaluator.resolveSegments(Seq("__.publishSonatypeCentral"), SelectMode.Multi),
        "resolve __.publishSonatypeCentral"
      )
        .map(_.render)
        .filter(_.endsWith(".publishSonatypeCentral"))
        .map { rendered =>
          if rendered.contains(' ') then
            throw new Exception(s"resolve __.publishSonatypeCentral: unexpected space in $rendered")
          rendered.stripSuffix(".publishSonatypeCentral")
        },
      cfg.excludedModuleSubstrings
    )

  private def evaluateAll(
      evaluator: Evaluator,
      selectors: Seq[String],
      what: String,
      selectMode: SelectMode = SelectMode.Multi
  ): Unit = {
    if selectors.isEmpty then throw new Exception(s"$what: no selectors")
    val evalResult = unwrap(evaluator.evaluate(selectors, selectMode), what)
    evalResult.values.toEither match {
      case Left(msg) => throw new Exception(s"$what failed: $msg")
      case Right(_)  => ()
    }
  }

  private def unwrap[T](result: Result[T], what: String): T =
    result.toEither match {
      case Right(value) => value
      case Left(msg)    => throw new Exception(s"$what failed: $msg")
    }

  /**
   * Mill Morphir plugins compile against `com.lihaoyi::mill-libs-scalalib`, which is on Maven Central for Mill 1.x —
   * the older mill-scalalib Central exclusion is retired; plugins are in the publish set.
   *
   * `publishSonatypeCentral` reads `MILL_PGP_*` from `Task.env` (process env at Mill start). `ci.sonatype.writeMillEnv`
   * converts Morphir CI `GPG_*` names; GHA sources that file first.
   */
  private def ensureMillPublishEnv()(using TaskCtx): Unit = {
    val env                            = Task.env
    def present(name: String): Boolean = env.get(name).exists(v => !v.isBlank)

    val missing = Seq.newBuilder[String]
    if !present("MILL_PGP_SECRET_BASE64") then missing += "MILL_PGP_SECRET_BASE64"
    if !present("MILL_PGP_PASSPHRASE") then missing += "MILL_PGP_PASSPHRASE"
    if !(present("MILL_SONATYPE_USERNAME") || present("SONATYPE_USERNAME")) then
      missing += "MILL_SONATYPE_USERNAME|SONATYPE_USERNAME"
    if !(present("MILL_SONATYPE_PASSWORD") || present("SONATYPE_PASSWORD")) then
      missing += "MILL_SONATYPE_PASSWORD|SONATYPE_PASSWORD"

    val absent = missing.result()
    if absent.nonEmpty then
      throw new Exception(
        s"Missing Mill publish env (${absent.mkString(", ")}). " +
          "Run ci.sonatype.writeMillEnv and source the file before ./mill -i ci.publish " +
          "(see the Release step in .github/workflows/ci.yml; helpers in org.finos.morphir.mill.publish)."
      )

    PgpSecret.validate(env("MILL_PGP_SECRET_BASE64"), msg => Task.log.info(msg))
  }
}
