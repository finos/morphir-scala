package build.morphir.testing.zio

import mill.*, mill.scalalib.*, mill.scalajslib.*
import millbuild.Deps
import build.{MorphirCommonCrossModule, MorphirJVMModule, MorphirJSModule}

trait Shared extends MorphirCommonCrossModule {
  def mvnDeps = Seq(
    mvn"io.github.cquiroz::scala-java-time::2.7.0",
    Deps.dev.zio.`zio-json`,
    Deps.dev.zio.`zio-prelude`,
    Deps.dev.zio.`zio-test`,
    Deps.dev.zio.`zio-test-sbt`
  )
}

object jvm extends Shared with MorphirJVMModule
object js  extends Shared with MorphirJSModule
