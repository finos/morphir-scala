package build.morphir.intelligence.sdk

import mill.*, mill.scalalib.*, mill.scalajslib.*
import mill.contrib.scoverage.ScoverageModule
import millbuild.crossplatform.*
import build.{MorphirCommonCrossModule, MorphirJVMModule, MorphirJSModule, MorphirIntelligencePublishModule}
import millbuild.{Deps, KyoTest, KyoTestJS, Versions => Vers}

object `package` extends CrossPlatform {

  trait Shared extends MorphirCommonCrossModule with MorphirIntelligencePublishModule {
    override def artifactName = "morphir-intelligence-sdk"
    def mvnDeps               = Seq(Deps.io.getkyo.`kyo-schema`)
  }

  // kyo-test-api/kyo-test-runner don't declare kyo-core/kyo-prelude as regular
  // transitive dependencies upstream (kyo-test's own sbt build wires them in via
  // unmanagedClasspath instead) — add them explicitly, or kyo-test's `assert`
  // macro fails to compile with "<notype> is not a value type" against modules
  // that don't otherwise pull kyo-core in transitively.
  def kyoTestMvnDeps = Seq(
    Deps.io.getkyo.`kyo-core`,
    Deps.io.getkyo.`kyo-prelude`,
    Deps.io.getkyo.`kyo-test-api`,
    Deps.io.getkyo.`kyo-test-runner`
  )

  object jvm extends Shared with MorphirJVMModule with ScoverageModule {
    def scoverageVersion = Vers.scoverage

    object test extends ScoverageTests with KyoTest {
      def mvnDeps = kyoTestMvnDeps
    }
  }

  object js extends Shared with MorphirJSModule {
    object test extends ScalaJSTests with KyoTestJS {
      def mvnDeps = kyoTestMvnDeps
    }
  }
}
