package build

import mill.*
import mill.api.BuildCtx

/** Mill entry points for the versioned upstream OpenSpec extension, served by the pinned mission-control-tools. */
trait MorphirOpenSpecModule extends Module {
  private def run(args: Seq[String], environment: Map[String, String]): Unit = {
    os.proc(Seq("mise", "exec", "--") ++ args).call(
      cwd = BuildCtx.workspaceRoot,
      env = environment,
      stdout = os.Inherit,
      stderr = os.Inherit
    )
    ()
  }

  /**
   * Re-read the ownership lock and files on every invocation so edits cannot use stale evidence. `--bundle` also fails
   * when the lock records another tool version than the pinned one, so a version bump without `install` fails.
   */
  def check() = Task.Command {
    run(Seq("mission-control-tools", "openspec", "check", "--bundle"), Task.env)
  }

  /** Keep personal OpenSpec profiles and delivery preferences out of project setup. */
  def setup() = Task.Command {
    run(Seq("mission-control-tools", "openspec", "setup"), Task.env)
  }

  def validate() = Task.Command {
    run(Seq("openspec", "schema", "validate", "html-design"), Task.env)
    run(Seq("openspec", "validate", "--all", "--strict"), Task.env)
  }

  /** The snapshot check, then schema and artifact validation. */
  def verify() = Task.Command {
    check()()
    validate()()
  }
}
