package build.format

import build.toolchains
import mill.scalalib.scalafmt.MorphirRootFormatModule

/**
 * Repo root `format` module: wires [[MorphirRootFormatModule]] to [[toolchains.elmFormat]].
 *
 * Commands live on the parent trait (`format`, `scala`, `elm`, `checkAll`).
 */
trait MorphirFormatModule extends MorphirRootFormatModule {
  def elmFormatTool = toolchains.elmFormat
}
