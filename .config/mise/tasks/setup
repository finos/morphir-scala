#!/usr/bin/env bash
# MISE description="Install project dependencies"
# MISE alias="install"

set -euo pipefail

echo "Setting up project..."
echo "  Installing npm dependencies..."
# Elm tooling is optional developer convenience. Mill owns Morphir Elm fixture
# generation, so setup must not run workspace postinstall hooks or install a
# second Morphir Elm CLI.
bun install --ignore-scripts
echo "Setup completed successfully"
