# Squire local settings template
#
# Copy this file to settings.local.yaml and fill in your values.
# settings.local.yaml is gitignored — safe for org-specific URLs and credentials.
#
# cp .config/squire/settings.local.yaml.template .config/squire/settings.local.yaml

cellar:
  # Extra Maven repository URLs passed to cellar for dependency resolution.
  # Add any internal/private Artifactory or Nexus mirrors your org uses.
  # These supplement (not replace) Maven Central.
  #
  # Note: the built-in aliases for kyo-case-app, kyo-schema, and kyo-zio
  # resolve to io.getkyo artifacts that are NOT on Maven Central. You must
  # add your organisation's Maven mirror here for those aliases to work.
  repositories:
    # - https://your-org.example.com/artifactory/sbt-repo
    # - https://your-org.example.com/artifactory/maven-repo

  # Optional: override the cellar binary path if not on PATH
  # binary: /path/to/cellar

tracking:
  # Task tracking for this checkout. See docs/task-tracking.md.
  #
  #   auto  (default) use beads if `bd` is installed and .beads/ exists
  #   beads           require beads; a missing `bd` is a setup problem to fix
  #   off             opt out entirely — agents use session-scoped tracking
  #                   instead and must not run `bd` write commands here
  #
  # Beads is never a prerequisite for contributing: nothing in the build, the
  # test suites or CI reads .beads/. This setting is a declaration of intent
  # that agents and scripts read, and it is gitignored, so it affects only you.
  #
  # Check what took effect:
  #   python3 .claude/skills/squire/scripts/tracking-status.py
  #
  # mode: auto
